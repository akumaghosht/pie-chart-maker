---
// FAQ section with schema.org JSON-LD structured data for SEO.
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { SupportedLanguage } from "../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
}

const urlLang = getLangFromUrl(Astro.url);
const currentLang = Astro.props.lang || urlLang;
const t = useTranslations(currentLang);

const rawFaqItems = [
  {
    q: t("faq.q1"),
    a: t("faq.a1"),
  },
  {
    q: t("faq.q2"),
    a: t("faq.a2"),
  },
  {
    q: t("faq.q3"),
    a: t("faq.a3"),
  },
  {
    q: t("faq.q4"),
    a: t("faq.a4"),
  },
];

const faqItems = rawFaqItems.filter(
  (item) => item.q && item.a && item.q !== "faq.q4" && item.a !== "faq.a4"
);

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": currentLang,
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
});
---

<section class="w-full bg-canvas-soft-2 border-b border-hairline py-16 md:py-24" id="faq">
  <div class="max-w-[800px] mx-auto px-6">
    <div class="text-center md:text-left mb-12">
      <span class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider select-none">{t("faq.badge")}</span>
      <h2 class="font-sans text-[28px] md:text-[36px] font-semibold tracking-[-1px] text-ink mt-2 text-balance">
        {t("faq.title")}
      </h2>
      <p class="font-sans text-sm text-body leading-relaxed mt-2 max-w-[560px]">
        {t("faq.subtitle")}
      </p>
    </div>

    <div class="flex flex-col gap-4">
      {
        faqItems.map((item) => (
          <details class="group bg-canvas border border-hairline rounded-md overflow-hidden transition-all duration-200 open:shadow-lvl2">
            <summary class="flex justify-between items-center p-5 font-sans font-medium text-ink hover:text-primary cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-primary select-none [&::-webkit-details-marker]:hidden">
              <span class="text-sm md:text-base">{item.q}</span>
              <span class="text-mute group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4">
                <svg class="w-5 h-5 stroke-current" fill="none" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 pt-0 border-t border-hairline/50 font-sans text-xs md:text-sm text-body leading-relaxed">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={schemaJson} />
