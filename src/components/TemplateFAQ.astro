---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  title?: string;
  subtitle?: string;
}

const {
  faqs,
  title = "Frequently Asked Questions",
  subtitle = "Everything you need to know about this chart template and how to customize your data.",
} = Astro.props;
---

<section class="w-full bg-canvas-soft-2 border-b border-hairline py-16 md:py-20" id="template-faq" aria-labelledby="faq-heading">
  <div class="max-w-[840px] mx-auto px-6">
    <div class="text-center md:text-left mb-10">
      <span class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider select-none">
        FAQ
      </span>
      <h2 id="faq-heading" class="font-sans text-[26px] md:text-[32px] font-semibold tracking-[-0.8px] text-ink mt-2 text-balance">
        {title}
      </h2>
      <p class="font-sans text-sm text-body leading-relaxed mt-2 max-w-[600px]">
        {subtitle}
      </p>
    </div>

    <div class="flex flex-col gap-3.5">
      {
        faqs.map((item) => (
          <details class="group bg-canvas border border-hairline rounded-md overflow-hidden transition-all duration-200 open:shadow-lvl2">
            <summary class="flex justify-between items-center p-5 font-sans font-medium text-ink hover:text-primary cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-primary select-none [&::-webkit-details-marker]:hidden">
              <span class="text-sm md:text-base font-medium text-ink pr-4 leading-snug">{item.question}</span>
              <span class="text-mute group-open:rotate-180 transition-transform duration-200 shrink-0">
                <svg class="w-4 h-4 stroke-current" fill="none" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 pt-0 border-t border-hairline/50 font-sans text-xs md:text-sm text-body leading-relaxed">
              <p class="mt-3.5">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

