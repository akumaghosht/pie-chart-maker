---
import { languages, type SupportedLanguage } from "../i18n/ui";
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

interface Props {
  variant?: "nav" | "footer";
  class?: string;
}

const { variant = "nav", class: className = "" } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
---

{
  variant === "nav" ? (
    <div class={`relative language-picker-nav ${className}`}>
      <button
        type="button"
        id="lang-picker-btn"
        class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-md text-xs font-sans font-medium text-body hover:text-ink hover:bg-canvas-soft-2 transition-all border border-hairline/60 focus-visible:outline-2 focus-visible:outline-primary cursor-pointer"
        aria-expanded="false"
        aria-haspopup="true"
        aria-label="Select language"
      >
        <!-- Globe icon -->
        <svg
          class="w-3.5 h-3.5 text-body shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 21a9 9 0 100-18 9 9 0 000 18z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.6 9h16.8M3.6 15h16.8"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M11.5 3a17 17 0 000 18M12.5 3a17 17 0 010 18"
          />
        </svg>
        <span class="font-sans text-[11px] sm:text-xs font-medium">
          {languages[currentLang]}
        </span>
        <!-- Chevron -->
        <svg
          class="w-3 h-3 text-mute transition-transform duration-150 chevron-icon"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <!-- Dropdown Menu -->
      <div
        id="lang-picker-menu"
        class="hidden absolute right-0 rtl:right-auto rtl:left-0 mt-1.5 w-40 max-h-80 overflow-y-auto py-1 bg-canvas border border-hairline rounded-md shadow-lvl3 z-50 text-left rtl:text-right overflow-x-hidden animate-in fade-in-0 zoom-in-95 duration-100"
        role="menu"
        aria-orientation="vertical"
        aria-labelledby="lang-picker-btn"
      >
        {
          (Object.entries(languages) as [SupportedLanguage, string][]).map(([code, name]) => {
            const isCurrent = code === currentLang;
            const targetHref = translatePath(Astro.url.pathname, code);
            return (
              <a
                href={targetHref}
                role="menuitem"
                lang={code}
                class={`flex items-center justify-between px-3 py-1.5 text-xs font-sans transition-colors ${
                  isCurrent
                    ? "font-semibold text-primary bg-primary/5"
                    : "text-body hover:text-ink hover:bg-canvas-soft-2"
                }`}
              >
                <span>{name}</span>
                {isCurrent && (
                  <svg
                    class="w-3.5 h-3.5 text-primary shrink-0"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </a>
            );
          })
        }
      </div>
    </div>
  ) : (
    <div class={`flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-sans ${className}`}>
      <span class="text-mute font-medium text-[11px] flex items-center gap-1">
        <svg class="w-3 h-3 text-mute" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
        </svg>
        Language:
      </span>
      {
        (Object.entries(languages) as [SupportedLanguage, string][]).map(([code, name]) => {
          const isCurrent = code === currentLang;
          const targetHref = translatePath(Astro.url.pathname, code);
          return (
            <a
              href={targetHref}
              lang={code}
              class={`transition-colors ${
                isCurrent
                  ? "font-semibold text-ink underline underline-offset-4 decoration-primary"
                  : "text-body hover:text-ink"
              }`}
            >
              {name}
            </a>
          );
        })
      }
    </div>
  )
}

<script>
  function setupLangPicker() {
    const btn = document.getElementById("lang-picker-btn");
    const menu = document.getElementById("lang-picker-menu");
    if (!btn || !menu) return;

    function toggleMenu(open?: boolean) {
      const willOpen = open !== undefined ? open : menu.classList.contains("hidden");
      if (willOpen) {
        menu.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
        const chevron = btn.querySelector(".chevron-icon");
        if (chevron) chevron.classList.add("rotate-180");
      } else {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
        const chevron = btn.querySelector(".chevron-icon");
        if (chevron) chevron.classList.remove("rotate-180");
      }
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        toggleMenu(false);
      }
    });
  }

  setupLangPicker();
  document.addEventListener("astro:page-load", setupLangPicker);
</script>
