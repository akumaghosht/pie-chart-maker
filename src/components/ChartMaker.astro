---
// ChartMaker.astro - The core application interface for the Pie Chart Maker
---

<div
  class="max-w-[1240px] mx-auto px-6 py-8 md:py-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
>
  <!-- Left Column: Inputs & Controls (7 Cols on desktop) -->
  <div class="lg:col-span-7 flex flex-col gap-6">
    <!-- Main Title Card -->
    <div
      class="bg-canvas p-6 md:p-8 rounded-md border border-hairline shadow-lvl2 relative overflow-hidden"
    >
      <!-- Background subtle gradient accent in Vercel style -->
      <div
        class="absolute top-0 left-0 w-full h-[3px] bg-gradient-to-r from-gradient-develop-start to-gradient-develop-end"
      >
      </div>
      <h1
        class="font-sans text-[28px] md:text-[36px] font-semibold tracking-tight text-ink leading-tight mb-2 text-balance"
      >
        Create beautiful pie charts.
      </h1>
      <p class="font-sans text-[14px] text-body leading-relaxed max-w-[500px]">
        Generate high-resolution vector charts dynamically. Enter data manually,
        paste raw text, or drop a spreadsheet. Completely private, fully
        customizable, and ad-free.
      </p>
    </div>

    <!-- Data Input Mode Panel -->
    <div
      class="bg-canvas rounded-md border border-hairline shadow-lvl2 overflow-hidden"
    >
      <!-- Tab Header -->
      <div
        class="flex border-b border-hairline bg-canvas-soft-2 px-2 pt-2 gap-1"
        role="tablist"
        aria-label="Data Input Sources"
      >
        <button
          id="tab-manual"
          class="px-4 py-2 text-xs font-mono font-medium rounded-t-sm border border-transparent border-b-0 -mb-[1px] hover:text-ink transition-colors cursor-pointer select-none text-ink bg-canvas border-hairline! active-tab"
          role="tab"
          aria-selected="true"
          aria-controls="panel-manual"
        >
          [ Manual Entry ]
        </button>
        <button
          id="tab-paste"
          class="px-4 py-2 text-xs font-mono font-medium rounded-t-sm border border-transparent border-b-0 -mb-[1px] text-body hover:text-ink transition-colors cursor-pointer select-none"
          role="tab"
          aria-selected="false"
          aria-controls="panel-paste"
        >
          [ Paste Text ]
        </button>
        <button
          id="tab-upload"
          class="px-4 py-2 text-xs font-mono font-medium rounded-t-sm border border-transparent border-b-0 -mb-[1px] text-body hover:text-ink transition-colors cursor-pointer select-none"
          role="tab"
          aria-selected="false"
          aria-controls="panel-upload"
        >
          [ CSV / XLSX File ]
        </button>
      </div>

      <!-- Tab Panels -->
      <div class="p-6">
        <!-- Manual Tab Panel -->
        <div
          id="panel-manual"
          class="flex flex-col gap-4"
          role="tabpanel"
          aria-labelledby="tab-manual"
        >
          <div class="flex items-center justify-between">
            <h2 class="font-sans text-sm font-semibold text-ink">
              Data Fields
            </h2>
            <div class="flex gap-2">
              <button
                id="btn-sort-val"
                class="inline-flex items-center justify-center h-7 px-2.5 bg-canvas border border-hairline rounded-sm text-xs font-sans text-body hover:bg-canvas-soft hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary cursor-pointer"
                title="Sort slices by value descending"
              >
                Sort by Value
              </button>
              <button
                id="btn-clear-all"
                class="inline-flex items-center justify-center h-7 px-2.5 bg-canvas border border-error-soft text-error rounded-sm text-xs font-sans hover:bg-error-soft/30 hover:text-error-deep transition-colors focus-visible:outline-2 focus-visible:outline-error cursor-pointer"
              >
                Clear All
              </button>
            </div>
          </div>

          <!-- Dynamic manual input rows container -->
          <div
            id="manual-rows-container"
            class="flex flex-col gap-2 max-h-[360px] overflow-y-auto pr-1"
          >
            <!-- Dynamic rows will be inserted here by JS -->
          </div>

          <button
            id="btn-add-row"
            class="w-full inline-flex items-center justify-center h-9 border border-dashed border-hairline-strong rounded-sm text-xs font-sans font-medium text-body hover:bg-canvas-soft hover:text-ink hover:border-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary cursor-pointer mt-2"
          >
            + Add Slice Field
          </button>
        </div>

        <!-- Paste Text Tab Panel -->
        <div
          id="panel-paste"
          class="hidden flex flex-col gap-4"
          role="tabpanel"
          aria-labelledby="tab-paste"
        >
          <label
            for="paste-textarea"
            class="font-sans text-xs font-medium text-body"
          >
            Paste raw text data (one item per line, separated by commas, tabs,
            spaces, or colons):
          </label>
          <textarea
            id="paste-textarea"
            rows="6"
            class="w-full font-mono text-xs p-3 border border-hairline rounded-sm focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors"
            placeholder="Apples, 45
Bananas: 80
Cherries 120
Oranges	25"
            spellcheck="false"
            autocomplete="off"></textarea>
          <div class="flex gap-3 justify-end">
            <button
              id="btn-parse-text"
              class="inline-flex items-center justify-center h-8 px-4 bg-primary text-on-primary rounded-sm text-xs font-sans font-medium hover:bg-primary/95 transition-colors focus-visible:outline-2 focus-visible:outline-primary cursor-pointer"
            >
              Extract & Update Slices
            </button>
          </div>
        </div>

        <!-- Upload File Tab Panel -->
        <div
          id="panel-upload"
          class="hidden flex flex-col gap-4"
          role="tabpanel"
          aria-labelledby="tab-upload"
        >
          <div
            id="dropzone"
            class="w-full border-2 border-dashed border-hairline hover:border-hairline-strong rounded-md p-8 text-center bg-canvas-soft-2 cursor-pointer transition-colors flex flex-col items-center justify-center gap-3"
            aria-label="File upload drag and drop area"
          >
            <svg
              class="text-mute w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5h10.5a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0017.25 4.5H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25z"
              ></path>
            </svg>
            <div class="flex flex-col gap-1">
              <span class="font-sans text-xs font-medium text-ink"
                >Drag & drop your CSV or XLSX file here</span
              >
              <span class="font-sans text-[11px] text-mute"
                >or click to browse your computer</span
              >
            </div>
            <input
              id="file-input"
              type="file"
              accept=".csv, .xlsx, .xls"
              class="hidden"
            />
          </div>
          <div
            id="file-error"
            class="hidden font-sans text-xs text-error-deep bg-error-soft px-3 py-2 rounded-sm border border-error-soft/50"
          >
          </div>
          <div class="font-sans text-[11px] text-mute leading-relaxed">
            Format: Column 1 should contain slice names, and Column 2 should
            contain values. First row will be ignored if it contains header
            text.
          </div>
        </div>
      </div>
    </div>

    <!-- Chart Customization Panel -->
    <div
      class="bg-canvas p-6 md:p-8 rounded-md border border-hairline shadow-lvl2 flex flex-col gap-6"
    >
      <h2
        class="font-sans text-sm font-semibold text-ink border-b border-hairline pb-3"
      >
        Chart Configurations
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Series Configuration -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label
              for="chart-title"
              class="font-sans text-xs font-medium text-body">Chart Title</label
            >
            <input
              id="chart-title"
              type="text"
              class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors"
              placeholder="e.g. Sales Breakdown 2026…"
              autocomplete="off"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label
              for="chart-subtitle"
              class="font-sans text-xs font-medium text-body"
              >Chart Subtitle</label
            >
            <input
              id="chart-subtitle"
              type="text"
              class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors"
              placeholder="e.g. Total Revenue by Department…"
              autocomplete="off"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label
              for="chart-source"
              class="font-sans text-xs font-medium text-body"
              >Data Source Citation</label
            >
            <input
              id="chart-source"
              type="text"
              class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors"
              placeholder="e.g. Source: World Bank Database…"
              autocomplete="off"
            />
          </div>
        </div>

        <!-- Visual Settings -->
        <div class="flex flex-col gap-4">
          <!-- Chart Type Toggle -->
          <div class="flex flex-col gap-2">
            <span class="font-sans text-xs font-medium text-body"
              >Chart Layout</span
            >
            <div class="flex gap-2">
              <label
                class="flex-1 inline-flex items-center justify-center h-8 px-4 rounded-sm border border-hairline-strong bg-canvas text-ink text-xs font-sans font-medium cursor-pointer select-none text-center shadow-lvl1 transition-all has-checked:bg-primary has-checked:text-on-primary has-checked:border-primary"
              >
                <input
                  type="radio"
                  name="chart-layout"
                  value="pie"
                  checked
                  class="sr-only"
                />
                Pie Chart
              </label>
              <label
                class="flex-1 inline-flex items-center justify-center h-8 px-4 rounded-sm border border-hairline bg-canvas text-body hover:text-ink text-xs font-sans font-medium cursor-pointer select-none text-center hover:bg-canvas-soft transition-all has-checked:bg-primary has-checked:text-on-primary has-checked:border-primary"
              >
                <input
                  type="radio"
                  name="chart-layout"
                  value="donut"
                  class="sr-only"
                />
                Donut Chart
              </label>
            </div>
          </div>

          <!-- 3D Toggle -->
          <div
            class="flex items-center justify-between py-1 border-b border-hairline/50"
          >
            <span class="font-sans text-xs font-medium text-body"
              >3D Isometric View</span
            >
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="toggle-3d" class="sr-only peer" />
              <div
                class="w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-hairline after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary border border-hairline"
              >
              </div>
            </label>
          </div>

          <!-- Hover Pop-out Toggle -->
          <div
            class="flex items-center justify-between py-1 border-b border-hairline/50"
          >
            <span class="font-sans text-xs font-medium text-body"
              >Pop Slices on Hover</span
            >
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="toggle-hover-pop"
                checked
                class="sr-only peer"
              />
              <div
                class="w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-hairline after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary border border-hairline"
              >
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Advanced Sliders (Tilt & Hole size) -->
      <div
        id="sliders-container"
        class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 border-t border-hairline/50"
      >
        <!-- Donut Hole radius slider -->
        <div id="slider-donut-hole-group" class="hidden flex flex-col gap-2">
          <div class="flex justify-between items-center">
            <label
              for="input-donut-hole"
              class="font-sans text-xs font-medium text-body"
              >Donut Hole Size</label
            >
            <span
              id="donut-hole-val"
              class="font-mono text-xs text-mute font-medium">50%</span
            >
          </div>
          <input
            id="input-donut-hole"
            type="range"
            min="20"
            max="80"
            value="50"
            class="w-full accent-primary h-1 bg-canvas-soft-2 rounded-lg cursor-pointer"
          />
        </div>

        <!-- 3D Tilt Slider -->
        <div id="slider-3d-tilt-group" class="hidden flex flex-col gap-2">
          <div class="flex justify-between items-center">
            <label
              for="input-3d-tilt"
              class="font-sans text-xs font-medium text-body"
              >3D Tilt Angle</label
            >
            <span
              id="3d-tilt-val"
              class="font-mono text-xs text-mute font-medium">55%</span
            >
          </div>
          <input
            id="input-3d-tilt"
            type="range"
            min="20"
            max="90"
            value="55"
            class="w-full accent-primary h-1 bg-canvas-soft-2 rounded-lg cursor-pointer"
          />
        </div>

        <!-- 3D Height Slider -->
        <div id="slider-3d-height-group" class="hidden flex flex-col gap-2">
          <div class="flex justify-between items-center">
            <label
              for="input-3d-height"
              class="font-sans text-xs font-medium text-body"
              >3D Extrusion Thickness</label
            >
            <span
              id="3d-height-val"
              class="font-mono text-xs text-mute font-medium">30px</span
            >
          </div>
          <input
            id="input-3d-height"
            type="range"
            min="10"
            max="70"
            value="30"
            class="w-full accent-primary h-1 bg-canvas-soft-2 rounded-lg cursor-pointer"
          />
        </div>
      </div>

      <!-- Typography & Styling Options -->
      <div class="pt-6 border-t border-hairline/50 flex flex-col gap-6">
        <h3 class="font-sans text-xs font-semibold text-ink">Style & Typography</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Left styling column -->
          <div class="flex flex-col gap-4">
            <!-- Font Family -->
            <div class="flex flex-col gap-1.5">
              <label for="font-family" class="font-sans text-xs font-medium text-body">Chart Font Family</label>
              <select id="font-family" class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors cursor-pointer">
                <option value="Inter">Inter (Sans-Serif)</option>
                <option value="Geist">Geist (Modern Sans)</option>
                <option value="Outfit">Outfit (Premium Sans)</option>
                <option value="Playfair Display">Playfair Display (Elegant Serif)</option>
                <option value="Lora">Lora (Classic Serif)</option>
                <option value="JetBrains Mono">JetBrains Mono (Monospace)</option>
              </select>
            </div>

            <!-- Label Mode -->
            <div class="flex flex-col gap-1.5">
              <label for="label-mode" class="font-sans text-xs font-medium text-body">Label Mode</label>
              <select id="label-mode" class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors cursor-pointer">
                <option value="label-percent">Name + Percentage (e.g. Marketing (15.5%))</option>
                <option value="label-value">Name + Value (e.g. Marketing (120))</option>
                <option value="label-value-percent">Name, Value & Percent (e.g. Marketing (120, 15.5%))</option>
                <option value="label">Name Only (e.g. Marketing)</option>
                <option value="value">Value Only (e.g. 120)</option>
                <option value="percent">Percentage Only (e.g. 15.5%)</option>
                <option value="none">None (Hide Labels)</option>
              </select>
            </div>
          </div>

          <!-- Right styling column: Typographical Settings -->
          <div class="flex flex-col gap-4">
            <!-- Typography & Colors Configuration -->
            <div class="flex flex-col gap-2">
              <span class="font-sans text-xs font-medium text-body">Typography Details</span>
              <div class="flex flex-col gap-2">
                <!-- Title Font Styling -->
                <div class="flex items-center justify-between gap-2 py-1 border-b border-hairline/30">
                  <span class="font-sans text-[11px] text-mute">Title Font</span>
                  <div class="flex items-center gap-1.5">
                    <select id="size-title" class="h-7 px-1.5 border border-hairline rounded-sm font-sans text-[10px] focus:outline-none bg-canvas-soft-2 cursor-pointer">
                      <option value="12">12px</option>
                      <option value="14">14px</option>
                      <option value="15" selected>15px</option>
                      <option value="16">16px</option>
                      <option value="18">18px</option>
                      <option value="20">20px</option>
                      <option value="24">24px</option>
                    </select>
                    <div class="relative w-6 h-6 rounded-sm overflow-hidden flex items-center justify-center border border-hairline cursor-pointer shrink-0">
                      <input type="color" id="color-title" class="absolute opacity-0 w-full h-full cursor-pointer" value="#171717" />
                      <div id="color-title-preview" class="w-full h-full" style="background-color: #171717"></div>
                    </div>
                    <input type="text" id="color-title-hex" class="w-14 h-7 px-1 border border-hairline rounded-sm font-mono text-[9px] focus:outline-none bg-canvas-soft-2 text-center" value="#171717" />
                  </div>
                </div>

                <!-- Subtitle Font Styling -->
                <div class="flex items-center justify-between gap-2 py-1 border-b border-hairline/30">
                  <span class="font-sans text-[11px] text-mute">Subtitle Font</span>
                  <div class="flex items-center gap-1.5">
                    <select id="size-subtitle" class="h-7 px-1.5 border border-hairline rounded-sm font-sans text-[10px] focus:outline-none bg-canvas-soft-2 cursor-pointer">
                      <option value="9">9px</option>
                      <option value="10">10px</option>
                      <option value="10.5" selected>10.5px</option>
                      <option value="11">11px</option>
                      <option value="12">12px</option>
                      <option value="14">14px</option>
                    </select>
                    <div class="relative w-6 h-6 rounded-sm overflow-hidden flex items-center justify-center border border-hairline cursor-pointer shrink-0">
                      <input type="color" id="color-subtitle" class="absolute opacity-0 w-full h-full cursor-pointer" value="#666666" />
                      <div id="color-subtitle-preview" class="w-full h-full" style="background-color: #666666"></div>
                    </div>
                    <input type="text" id="color-subtitle-hex" class="w-14 h-7 px-1 border border-hairline rounded-sm font-mono text-[9px] focus:outline-none bg-canvas-soft-2 text-center" value="#666666" />
                  </div>
                </div>

                <!-- Slice Labels Font Styling -->
                <div class="flex items-center justify-between gap-2 py-1 border-b border-hairline/30">
                  <span class="font-sans text-[11px] text-mute">Slice Labels Font</span>
                  <div class="flex items-center gap-1.5">
                    <select id="size-label" class="h-7 px-1.5 border border-hairline rounded-sm font-sans text-[10px] focus:outline-none bg-canvas-soft-2 cursor-pointer">
                      <option value="8">8px</option>
                      <option value="9">9px</option>
                      <option value="9.5" selected>9.5px</option>
                      <option value="10">10px</option>
                      <option value="11">11px</option>
                      <option value="12">12px</option>
                    </select>
                    <div class="relative w-6 h-6 rounded-sm overflow-hidden flex items-center justify-center border border-hairline cursor-pointer shrink-0">
                      <input type="color" id="color-label" class="absolute opacity-0 w-full h-full cursor-pointer" value="#171717" />
                      <div id="color-label-preview" class="w-full h-full" style="background-color: #171717"></div>
                    </div>
                    <input type="text" id="color-label-hex" class="w-14 h-7 px-1 border border-hairline rounded-sm font-mono text-[9px] focus:outline-none bg-canvas-soft-2 text-center" value="#171717" />
                  </div>
                </div>

                <!-- Source Font Styling -->
                <div class="flex items-center justify-between gap-2 py-1 border-b border-hairline/30">
                  <span class="font-sans text-[11px] text-mute">Source Font</span>
                  <div class="flex items-center gap-1.5">
                    <select id="size-source" class="h-7 px-1.5 border border-hairline rounded-sm font-sans text-[10px] focus:outline-none bg-canvas-soft-2 cursor-pointer">
                      <option value="7">7px</option>
                      <option value="8" selected>8px</option>
                      <option value="9">9px</option>
                      <option value="10">10px</option>
                    </select>
                    <div class="relative w-6 h-6 rounded-sm overflow-hidden flex items-center justify-center border border-hairline cursor-pointer shrink-0">
                      <input type="color" id="color-source" class="absolute opacity-0 w-full h-full cursor-pointer" value="#666666" />
                      <div id="color-source-preview" class="w-full h-full" style="background-color: #666666"></div>
                    </div>
                    <input type="text" id="color-source-hex" class="w-14 h-7 px-1 border border-hairline rounded-sm font-mono text-[9px] focus:outline-none bg-canvas-soft-2 text-center" value="#666666" />
                  </div>
                </div>
              </div>
            </div>

            <!-- Viewport Background -->
            <div class="flex flex-col gap-2">
              <span class="font-sans text-xs font-medium text-body">Chart Background</span>
              <div class="flex flex-wrap items-center gap-2">
                <!-- Preset circles -->
                <button type="button" class="btn-bg-preset w-6 h-6 rounded-full border border-hairline cursor-pointer focus:outline-none transition-transform hover:scale-105 active:scale-95 flex items-center justify-center text-[10px] text-mute" data-bg="transparent" title="Transparent" style="background-color: transparent;">
                  ∅
                </button>
                <button type="button" class="btn-bg-preset w-6 h-6 rounded-full border border-hairline cursor-pointer focus:outline-none transition-transform hover:scale-105 active:scale-95 bg-white" data-bg="#ffffff" title="Solid White"></button>
                <button type="button" class="btn-bg-preset w-6 h-6 rounded-full border border-hairline cursor-pointer focus:outline-none transition-transform hover:scale-105 active:scale-95 bg-neutral-50" data-bg="#fafafa" title="Soft Gray"></button>
                <button type="button" class="btn-bg-preset w-6 h-6 rounded-full border border-hairline cursor-pointer focus:outline-none transition-transform hover:scale-105 active:scale-95 bg-neutral-900" data-bg="#0a0a0a" title="Deep Dark"></button>
                
                <!-- Sleek gradients presets -->
                <button type="button" class="btn-bg-preset w-6 h-6 rounded-full border border-hairline cursor-pointer focus:outline-none transition-transform hover:scale-105 active:scale-95" data-bg="linear-gradient(135deg, #fdfbf7 0%, #eee5d3 100%)" title="Warm Mesh" style="background: linear-gradient(135deg, #fdfbf7 0%, #eee5d3 100%);"></button>
                <button type="button" class="btn-bg-preset w-6 h-6 rounded-full border border-hairline cursor-pointer focus:outline-none transition-transform hover:scale-105 active:scale-95" data-bg="linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%)" title="Ice Teal" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);"></button>
