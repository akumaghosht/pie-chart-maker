  function loadGoogleFont(fontName) {
    if (!fontName) return;
    if (fontName === "Inter" || fontName === "Geist" || fontName === "JetBrains Mono" || fontName === "system-ui") return;
    const fontId = `gfont-${fontName.toLowerCase().replace(/\s+/g, '-')}`;
    if (document.getElementById(fontId)) return;
    
    const link = document.createElement('link');
    link.id = fontId;
    link.rel = 'stylesheet';
    link.href = `https://fonts.googleapis.com/css2?family=${fontName.replace(/\s+/g, '+')}:wght@400;500;600;700&display=swap`;
    document.head.appendChild(link);
  }

  function syncUiFromConfig() {
    // 1. Headers/Text fields
    inputTitle.value = chartConfig.title || "";
    inputSubtitle.value = chartConfig.subtitle || "";
    inputSource.value = chartConfig.source || "";

    // 2. Layout Radios (Pie vs Donut)
    const layoutRadios = document.querySelectorAll('input[name="chart-layout"]');
    layoutRadios.forEach((radio) => {
      radio.checked =
        (radio.value === "donut" && chartConfig.isDonut) ||
        (radio.value === "pie" && !chartConfig.isDonut);
      updateCheckedStyle(radio);
    });

    // 3. Toggles
    toggle3D.checked = !!chartConfig.is3D;
    toggleHoverPop.checked = !chartConfig.disableHoverOffset;
    toggleShowTitle.checked = chartConfig.showTitle !== false;
    toggleShowSubtitle.checked = chartConfig.showSubtitle !== false;
    toggleShowLabels.checked = chartConfig.showLabels !== false && chartConfig.labelMode !== "none";
    toggleShowLegend.checked = chartConfig.showLegend !== false;
    inputTitle.disabled = !toggleShowTitle.checked;
    inputTitle.classList.toggle("opacity-50", !toggleShowTitle.checked);
    inputSubtitle.disabled = !toggleShowSubtitle.checked;
    inputSubtitle.classList.toggle("opacity-50", !toggleShowSubtitle.checked);
    selectLabelMode.disabled = !toggleShowLabels.checked;
    selectLabelMode.classList.toggle("opacity-50", !toggleShowLabels.checked);

    // 4. Sliders
    inputDonutHole.value = Math.round((chartConfig.donutHoleRadius ?? 0.5) * 100).toString();
    donutHoleVal.textContent = `${inputDonutHole.value}%`;

    inputChartSize.value = (chartConfig.chartSize ?? 100).toString();
    chartSizeVal.textContent = `${inputChartSize.value}%`;

    input3dHeight.value = (chartConfig.height3D ?? 30).toString();
    heightVal.textContent = `${input3dHeight.value}px`;

    // 5. Custom Styling dropdowns
    selectFontFamily.value = chartConfig.fontFamily || "Inter";
    loadGoogleFont(chartConfig.fontFamily);
    selectLabelMode.value = chartConfig.labelMode || "label-percent";
    selectTitleSize.value = (chartConfig.titleFontSize ?? 15).toString();
    selectSubtitleSize.value = (chartConfig.subtitleFontSize ?? 10.5).toString();
    selectLabelSize.value = (chartConfig.labelFontSize ?? 9.5).toString();
    selectSourceSize.value = (chartConfig.sourceFontSize ?? 8).toString();
    
    // 6. Color Pickers & Hex inputs
    inputTitleColor.value = chartConfig.titleColor || "#171717";
    inputTitleColorHex.value = chartConfig.titleColor || "#171717";
    previewTitleColor.style.backgroundColor = chartConfig.titleColor || "#171717";

    inputSubtitleColor.value = chartConfig.subtitleColor || "#666666";
    inputSubtitleColorHex.value = chartConfig.subtitleColor || "#666666";
    previewSubtitleColor.style.backgroundColor = chartConfig.subtitleColor || "#666666";

    inputLabelColor.value = chartConfig.labelColor || "#171717";
    inputLabelColorHex.value = chartConfig.labelColor || "#171717";
    previewLabelColor.style.backgroundColor = chartConfig.labelColor || "#171717";

    inputSourceColor.value = chartConfig.sourceColor || "#666666";
    inputSourceColorHex.value = chartConfig.sourceColor || "#666666";
    previewSourceColor.style.backgroundColor = chartConfig.sourceColor || "#666666";

    // 7. Viewport Background Custom picker & presets
    const bg = chartConfig.backgroundColor || "#ffffff";
    inputBgColorHex.value = bg;
    if (!bg.includes("linear-gradient")) {
      const solidColor = bg === "transparent" ? "#ffffff" : bg;
      inputBgColor.value = solidColor;
      previewBgColor.style.background = solidColor;
      previewBgColor.style.backgroundColor = solidColor;
    } else {
      previewBgColor.style.background = bg;
    }

    if (plusIcon) {
      plusIcon.style.opacity = bg === "transparent" ? "1" : "0";
    }

    presetBgButtons.forEach((btn) => {
      if (btn.getAttribute("data-bg") === bg) {
        btn.classList.add("scale-110", "border-hairline-strong");
      } else {
        btn.classList.remove("scale-110", "border-hairline-strong");
      }
    });

    // 8. Update slider panel visibility based on Donut/3D states
    updateControlVisibility();
  }

  // Tab buttons and panels
  const tabs = {
    manual: {
      btn: document.getElementById("tab-manual"),
      panel: document.getElementById("panel-manual"),
    },
    paste: {
      btn: document.getElementById("tab-paste"),
      panel: document.getElementById("panel-paste"),
    },
    upload: {
      btn: document.getElementById("tab-upload"),
      panel: document.getElementById("panel-upload"),
    },
  };

  // --- Initializing Functions ---

  function init() {
    // 1. Hook up tabs
    Object.keys(tabs).forEach((key) => {
      tabs[key].btn.addEventListener("click", () => switchTab(key));
    });

    // 2. Load configurations into Inputs
    inputTitle.value = chartConfig.title;
    inputSubtitle.value = chartConfig.subtitle;

    // Layout Radios
    const layoutRadios = document.querySelectorAll(
      'input[name="chart-layout"]',
    );
    layoutRadios.forEach((radio) => {
      // Set checked state
      if (
        (radio.value === "donut" && chartConfig.isDonut) ||
        (radio.value === "pie" && !chartConfig.isDonut)
      ) {
        radio.checked = true;
        updateCheckedStyle(radio);
      }
      // Add event listener
      radio.addEventListener("change", (e) => {
        chartConfig.isDonut = e.target.value === "donut";
        layoutRadios.forEach((r) => updateCheckedStyle(r));
        updateControlVisibility();
        triggerRender();
      });
    });

    // 3D toggle
    toggle3D.checked = chartConfig.is3D;
    toggle3D.addEventListener("change", (e) => {
      chartConfig.is3D = e.target.checked;
      updateControlVisibility();
      triggerRender();
    });

    // Hover cutaway toggle
    toggleHoverPop.checked = !chartConfig.disableHoverOffset;
    toggleHoverPop.addEventListener("change", (e) => {
      chartConfig.disableHoverOffset = !e.target.checked;
      triggerRender();
    });

    // Show Title toggle
    toggleShowTitle.checked = chartConfig.showTitle !== false;
    toggleShowTitle.addEventListener("change", (e) => {
      chartConfig.showTitle = e.target.checked;
      inputTitle.disabled = !e.target.checked;
      inputTitle.classList.toggle("opacity-50", !e.target.checked);
      triggerRender();
    });

    // Show Subtitle toggle
    toggleShowSubtitle.checked = chartConfig.showSubtitle !== false;
    toggleShowSubtitle.addEventListener("change", (e) => {
      chartConfig.showSubtitle = e.target.checked;
      inputSubtitle.disabled = !e.target.checked;
      inputSubtitle.classList.toggle("opacity-50", !e.target.checked);
      triggerRender();
    });

    // Show Labels toggle
    toggleShowLabels.checked = chartConfig.showLabels !== false && chartConfig.labelMode !== "none";
    toggleShowLabels.addEventListener("change", (e) => {
      chartConfig.showLabels = e.target.checked;
      selectLabelMode.disabled = !e.target.checked;
      selectLabelMode.classList.toggle("opacity-50", !e.target.checked);
      if (e.target.checked && chartConfig.labelMode === "none") {
        chartConfig.labelMode = "label-percent";
        selectLabelMode.value = "label-percent";
      }
      triggerRender();
    });

    // Show Bottom Legend / Index toggle
    toggleShowLegend.checked = chartConfig.showLegend !== false;
    toggleShowLegend.addEventListener("change", (e) => {
      chartConfig.showLegend = e.target.checked;
      updateControlVisibility();
      triggerRender();
    });

    // Inputs listeners
    inputTitle.addEventListener("input", (e) => {
      chartConfig.title = e.target.value;
      updateHeaders();
      triggerRender();
    });

    inputSubtitle.addEventListener("input", (e) => {
      chartConfig.subtitle = e.target.value;
      updateHeaders();
      triggerRender();
    });

    inputSource.addEventListener("input", (e) => {
      chartConfig.source = e.target.value;
      triggerRender();
    });

    selectTitleSize.addEventListener("change", (e) => {
      chartConfig.titleFontSize = parseFloat(e.target.value);
      triggerRender();
    });

    selectSubtitleSize.addEventListener("change", (e) => {
      chartConfig.subtitleFontSize = parseFloat(e.target.value);
      triggerRender();
    });

    selectLabelSize.addEventListener("change", (e) => {
      chartConfig.labelFontSize = parseFloat(e.target.value);
      triggerRender();
    });

    selectSourceSize.addEventListener("change", (e) => {
      chartConfig.sourceFontSize = parseFloat(e.target.value);
      triggerRender();
    });

    // Sliders
    inputDonutHole.addEventListener("input", (e) => {
      chartConfig.donutHoleRadius = parseFloat(e.target.value) / 100;
      donutHoleVal.textContent = `${e.target.value}%`;
      triggerRender();
    });

    inputChartSize.addEventListener("input", (e) => {
      chartConfig.chartSize = parseInt(e.target.value, 10);
      chartSizeVal.textContent = `${e.target.value}%`;
      triggerRender();
    });

    input3dHeight.addEventListener("input", (e) => {
      chartConfig.height3D = parseInt(e.target.value);
      heightVal.textContent = `${e.target.value}px`;
      triggerRender();
    });

    // Custom Font selector
    selectFontFamily.value = chartConfig.fontFamily;
    loadGoogleFont(chartConfig.fontFamily);
    selectFontFamily.addEventListener("change", (e) => {
      chartConfig.fontFamily = e.target.value;
      loadGoogleFont(chartConfig.fontFamily);
      triggerRender();
    });

    // Label Mode selector
    selectLabelMode.value = chartConfig.labelMode;
    selectLabelMode.addEventListener("change", (e) => {
      chartConfig.labelMode = e.target.value;
      if (e.target.value === "none") {
        chartConfig.showLabels = false;
        toggleShowLabels.checked = false;
      } else {
        chartConfig.showLabels = true;
        toggleShowLabels.checked = true;
      }
      triggerRender();
    });

    // Title Color pickers
    inputTitleColor.value = chartConfig.titleColor;
    inputTitleColorHex.value = chartConfig.titleColor;
    previewTitleColor.style.backgroundColor = chartConfig.titleColor;

    inputTitleColor.addEventListener("input", (e) => {
      const val = e.target.value;
      inputTitleColorHex.value = val;
      previewTitleColor.style.backgroundColor = val;
      chartConfig.titleColor = val;
      triggerRender();
    });

    inputTitleColorHex.addEventListener("input", (e) => {
      let val = e.target.value.trim();
      if (!val.startsWith("#")) val = "#" + val;
      if (/^#[0-9a-fA-F]{3,8}$/.test(val)) {
        inputTitleColor.value = val;
        previewTitleColor.style.backgroundColor = val;
        chartConfig.titleColor = val;
        triggerRender();
      }
    });

    // Subtitle Color pickers
    inputSubtitleColor.value = chartConfig.subtitleColor;
    inputSubtitleColorHex.value = chartConfig.subtitleColor;
    previewSubtitleColor.style.backgroundColor = chartConfig.subtitleColor;

    inputSubtitleColor.addEventListener("input", (e) => {
      const val = e.target.value;
      inputSubtitleColorHex.value = val;
      previewSubtitleColor.style.backgroundColor = val;
      chartConfig.subtitleColor = val;
      triggerRender();
    });

    inputSubtitleColorHex.addEventListener("input", (e) => {
      let val = e.target.value.trim();
      if (!val.startsWith("#")) val = "#" + val;
      if (/^#[0-9a-fA-F]{3,8}$/.test(val)) {
        inputSubtitleColor.value = val;
        previewSubtitleColor.style.backgroundColor = val;
        chartConfig.subtitleColor = val;
        triggerRender();
      }
    });

    // Label Color pickers
    inputLabelColor.value = chartConfig.labelColor;
    inputLabelColorHex.value = chartConfig.labelColor;
    previewLabelColor.style.backgroundColor = chartConfig.labelColor;

    // Source Color pickers
    inputSourceColor.value = chartConfig.sourceColor || "#666666";
    inputSourceColorHex.value = chartConfig.sourceColor || "#666666";
    previewSourceColor.style.backgroundColor = chartConfig.sourceColor || "#666666";

    inputSourceColor.addEventListener("input", (e) => {
      const val = e.target.value;
      inputSourceColorHex.value = val;
      previewSourceColor.style.backgroundColor = val;
      chartConfig.sourceColor = val;
      triggerRender();
    });

    inputSourceColorHex.addEventListener("input", (e) => {
      let val = e.target.value.trim();
      if (!val.startsWith("#")) val = "#" + val;
      if (/^#[0-9a-fA-F]{3,8}$/.test(val)) {
        inputSourceColor.value = val;
        previewSourceColor.style.backgroundColor = val;
        chartConfig.sourceColor = val;
        triggerRender();
      }
    });

    inputLabelColor.addEventListener("input", (e) => {
      const val = e.target.value;
      inputLabelColorHex.value = val;
      previewLabelColor.style.backgroundColor = val;
      chartConfig.labelColor = val;
      triggerRender();
    });

    inputLabelColorHex.addEventListener("input", (e) => {
      let val = e.target.value.trim();
      if (!val.startsWith("#")) val = "#" + val;
      if (/^#[0-9a-fA-F]{3,8}$/.test(val)) {
        inputLabelColor.value = val;
        previewLabelColor.style.backgroundColor = val;
        chartConfig.labelColor = val;
        triggerRender();
      }
    });

    // Viewport Background Presets and Custom Color
    function updateBgState(val) {
      chartConfig.backgroundColor = val;
      chartConfig.isExplicitBg = true;
      inputBgColorHex.value = val;
      
      if (!val.includes("linear-gradient")) {
        const solidColor = val === "transparent" ? "#ffffff" : val;
        inputBgColor.value = solidColor;
        previewBgColor.style.background = solidColor;
        previewBgColor.style.backgroundColor = solidColor;
      } else {
        previewBgColor.style.background = val;
      }
      
      if (plusIcon) {
        plusIcon.style.opacity = val === "transparent" ? "1" : "0";
      }
      
      presetBgButtons.forEach((btn) => {
        if (btn.getAttribute("data-bg") === val) {
          btn.classList.add("scale-110", "border-hairline-strong");
        } else {
          btn.classList.remove("scale-110", "border-hairline-strong");
        }
      });
      
      triggerRender();
    }

    presetBgButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        updateBgState(btn.getAttribute("data-bg"));
      });
    });

    inputBgColor.addEventListener("input", (e) => {
      updateBgState(e.target.value);
    });

    inputBgColorHex.addEventListener("input", (e) => {
      const val = e.target.value.trim();
      if (val === "transparent" || val.includes("linear-gradient") || /^#[0-9a-fA-F]{3,8}$/.test(val)) {
        updateBgState(val);
      }
    });

    // Button controls
    btnAddRow.addEventListener("click", addNewRow);
    btnClearAll.addEventListener("click", clearAllRows);
    btnSortVal.addEventListener("click", sortSlicesByValue);

    // Paste parse
    btnParseText.addEventListener("click", parseRawText);

    // File Drag-n-Drop
    setupFileDropzone();

    // Sharing & Exports
    btnShareCopy.addEventListener("click", copyShareLink);
    btnExportPng.addEventListener("click", downloadPng);
    btnExportSvg.addEventListener("click", downloadSvg);
    btnExportPdf.addEventListener("click", downloadPdf);
    btnCopySvg.addEventListener("click", copySvgToClipboard);

    // Drafts
    btnDraftSave.addEventListener("click", saveDraft);

    // Reset preview
    btnResetPreview.addEventListener("click", resetChartToDefaults);

    // Load URL state or default localStorage state
    loadUrlOrStorageState();

    // Initial renders
    updateControlVisibility();
    syncManualRowsUI();
    triggerRender();
    loadDraftsHistory();
  }

  // --- Rendering & UI Syncing Loop ---

  function triggerRender() {
    if (!svgViewport) return;

    if (chartConfig.is3D) {
      // --- Three.js 3D mode ---
      // Show Three.js container
      threeContainer.classList.remove('hidden');

      // Position SVG viewport as a transparent overlay on top of 3D canvas
      svgViewport.style.display = '';
      svgViewport.style.pointerEvents = 'none';
      svgViewport.classList.add('absolute', 'inset-0', 'z-10');

      // Apply background color to the viewport wrapper behind everything
      const bg = chartConfig.backgroundColor || '#ffffff';
      viewportWrapper.style.background = bg === 'transparent' ? 'transparent' : bg;
      threeContainer.style.background = 'transparent';

      // Render the SVG overlay: Title, Subtitle, Legend, Source
      renderChart(svgViewport, chartData, { ...chartConfig, isWebGL3D: true });

      // Initialize or update the 3D chart, attaching dynamic real-time projected labels to svgViewport
      if (!three3DInstance) {
        three3DInstance = render3DChart(threeContainer, chartData, chartConfig, svgViewport);
      } else {
        three3DInstance.update(chartData, chartConfig, svgViewport);
      }
    } else {
      // --- SVG 2D mode ---
      threeContainer.classList.add('hidden');
      svgViewport.style.display = '';
      svgViewport.style.pointerEvents = 'auto';
      svgViewport.classList.remove('absolute', 'inset-0', 'z-10');
      viewportWrapper.style.background = '';

      // Dispose Three.js instance
      if (three3DInstance) {
        three3DInstance.dispose();
        three3DInstance = null;
      }

      // Render full 2D SVG graph
      renderChart(svgViewport, chartData, { ...chartConfig, isWebGL3D: false });
    }

    // Update headers and side legend lists
    updateHeaders();
    syncLegendUI();
    generateShareLink();
  }

  function updateHeaders() {
    previewTitle.textContent = chartConfig.showTitle !== false ? (chartConfig.title || "") : "";
    previewSubtitle.textContent = chartConfig.showSubtitle !== false ? (chartConfig.subtitle || "") : "";

    if (!chartConfig.title || chartConfig.showTitle === false) {
      previewTitle.textContent = chartConfig.showTitle !== false ? "Pie Chart Maker" : "";
      previewTitle.classList.add("text-mute/50");
    } else {
      previewTitle.classList.remove("text-mute/50");
    }
  }

  function updateControlVisibility() {
    // Toggle Donut Slider visibility
    if (chartConfig.isDonut) {
      sliderDonutHoleGroup.classList.remove("hidden");
    } else {
      sliderDonutHoleGroup.classList.add("hidden");
    }

    // Toggle 3D options visibility
    if (chartConfig.is3D) {
      slider3dHeightGroup.classList.remove("hidden");
    } else {
      slider3dHeightGroup.classList.add("hidden");
    }

    // Toggle Slices Distribution / Legend card at the bottom
    if (chartLegendCard) {
      if (chartConfig.showLegend !== false) {
        chartLegendCard.classList.remove("hidden");
      } else {
        chartLegendCard.classList.add("hidden");
      }
    }
  }

  function updateCheckedStyle(radio) {
    const parentLabel = radio.parentElement;
    if (radio.checked) {
      parentLabel.classList.remove(
        "border-hairline",
        "text-body",
        "hover:bg-canvas-soft",
      );
      parentLabel.classList.add(
        "border-hairline-strong",
        "bg-canvas",
        "text-ink",
        "shadow-lvl1",
      );
    } else {
      parentLabel.classList.remove(
        "border-hairline-strong",
        "bg-canvas",
        "text-ink",
        "shadow-lvl1",
      );
      parentLabel.classList.add(
        "border-hairline",
        "text-body",
        "hover:bg-canvas-soft",
      );
    }
  }

  // --- Tab Management ---

  function switchTab(activeKey) {
    Object.keys(tabs).forEach((key) => {
      const { btn, panel } = tabs[key];
      if (key === activeKey) {
        btn.classList.add(
          "bg-canvas",
          "border-hairline!",
          "text-ink",
          "active-tab",
        );
        btn.setAttribute("aria-selected", "true");
        panel.classList.remove("hidden");
      } else {
        btn.classList.remove(
          "bg-canvas",
          "border-hairline!",
          "text-ink",
          "active-tab",
        );
        btn.setAttribute("aria-selected", "false");
        panel.classList.add("hidden");
      }
    });
  }

  // --- Manual Editor Operations ---

  function syncManualRowsUI() {
    manualRowsContainer.innerHTML = "";

    chartData.forEach((row, index) => {
      const rowDiv = document.createElement("div");
      rowDiv.className =
        "flex items-center gap-2 border border-hairline rounded-sm p-1.5 bg-canvas-soft hover:bg-canvas hover:border-hairline-strong transition-colors";
      rowDiv.dataset.index = index;

      rowDiv.innerHTML = `
        <!-- Color Picker Box -->
        <div class="relative w-8 h-8 rounded-sm overflow-hidden flex items-center justify-center border border-hairline cursor-pointer shrink-0 shadow-lvl1 hover:opacity-90 transition-opacity">
          <input 
            type="color" 
            class="absolute opacity-0 w-full h-full cursor-pointer" 
            value="${row.color}" 
            aria-label="Pick color for ${escapeHTML(row.label)}"
          />
          <div class="w-full h-full" style="background-color: ${row.color}"></div>
        </div>

        <!-- Label Input -->
        <input 
          type="text" 
          placeholder="${slicePlaceholder}" 
          class="flex-grow min-w-0 h-8 px-2 border border-hairline focus:border-hairline-strong focus:outline-none rounded-sm text-xs font-sans bg-canvas-soft-2 focus:bg-canvas transition-colors"
          value="${escapeHTML(row.label)}"
          autocomplete="off"
        />

        <!-- Value Input -->
        <input 
          type="number" 
          placeholder="${valPlaceholder}" 
          min="0.0001" 
          step="any"
          class="w-20 h-8 px-2 border border-hairline focus:border-hairline-strong focus:outline-none rounded-sm text-xs font-mono bg-canvas-soft-2 focus:bg-canvas text-right transition-colors"
          value="${row.value}"
        />

        <!-- Delete button -->
        <button 
          type="button"
          class="w-8 h-8 inline-flex items-center justify-center text-mute hover:text-error-deep rounded-sm hover:bg-error-soft/30 transition-colors focus-visible:outline-2 focus-visible:outline-error cursor-pointer shrink-0"
          aria-label="${deleteSliceLabel} ${escapeHTML(row.label) || index + 1}"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M1.5 3.5h11M11.5 3.5v9a1 1 0 01-1 1h-7a1 1 0 01-1-1v-9m2 0V2a1 1 0 011-1h3a1 1 0 011 1v1.5M5.5 6.5v4M8.5 6.5v4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      `;

      // Event bindings
      const colorInput = rowDiv.querySelector('input[type="color"]');
      const colorDisplay = colorInput.nextElementSibling;
      const labelInput = rowDiv.querySelector('input[type="text"]');
      const valInput = rowDiv.querySelector('input[type="number"]');
      const deleteBtn = rowDiv.querySelector("button");

      colorInput.addEventListener("input", (e) => {
        const val = e.target.value;
        colorDisplay.style.backgroundColor = val;
        chartData[index].color = val;
        triggerRender();
      });

      labelInput.addEventListener("input", (e) => {
        chartData[index].label = e.target.value;
        triggerRender();
      });

      valInput.addEventListener("input", (e) => {
        const val = parseFloat(e.target.value);
        chartData[index].value = isNaN(val) ? 0 : val;
        triggerRender();
      });

      deleteBtn.addEventListener("click", () => {
        chartData.splice(index, 1);
        syncManualRowsUI();
        triggerRender();
      });

      manualRowsContainer.appendChild(rowDiv);
    });
  }

  function addNewRow() {
    const defaultColor = getColor(chartData.length);
    chartData.push({
      label: `${slicePrefix} ${chartData.length + 1}`,
      value: 100,
      color: defaultColor,
    });
    syncManualRowsUI();
    triggerRender();

    // Scroll dynamic panel to bottom
    setTimeout(() => {
      manualRowsContainer.scrollTop = manualRowsContainer.scrollHeight;
    }, 50);
  }

  function clearAllRows() {
    chartData = [];
    syncManualRowsUI();
    triggerRender();
  }

  function sortSlicesByValue() {
    chartData.sort((a, b) => b.value - a.value);
    syncManualRowsUI();
    triggerRender();
  }

  // --- Dynamic Legend Construction ---

  function syncLegendUI() {
    chartLegend.innerHTML = "";

    const validData = chartData.filter(
      (d) => d && typeof d.value === "number" && d.value > 0,
    );
    const total = validData.reduce((sum, d) => sum + d.value, 0);
    legendTotalVal.textContent = total.toLocaleString();

    if (validData.length === 0) {
      chartLegend.innerHTML = `
        <div class="text-center font-sans text-xs text-mute py-4 leading-relaxed">
          ${noDataText}
        </div>
      `;
      return;
    }

    validData.forEach((row) => {
      const percent = total > 0 ? (row.value / total) * 100 : 0;

      const idx = chartData.indexOf(row);
      const rowDiv = document.createElement("div");
      rowDiv.className =
        "legend-item flex items-center justify-between py-1.5 px-2.5 rounded-sm border border-transparent font-sans text-xs hover:bg-canvas-soft-2 hover:border-hairline transition-all cursor-pointer";
      rowDiv.dataset.index = idx;

      rowDiv.addEventListener("mouseenter", () => {
        if (chartConfig.is3D && three3DInstance && three3DInstance.highlightByIndex) {
          three3DInstance.highlightByIndex(idx);
        }
      });
      rowDiv.addEventListener("mouseleave", () => {
        if (chartConfig.is3D && three3DInstance && three3DInstance.clearHighlight) {
          three3DInstance.clearHighlight();
        }
      });

      rowDiv.innerHTML = `
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: ${row.color}"></span>
          <span class="font-medium text-ink truncate">${escapeHTML(row.label) || untitledText}</span>
        </div>
        <div class="flex items-center gap-4 shrink-0 font-mono text-mute">
          <span>${row.value.toLocaleString()}</span>
          <span class="w-12 text-right font-medium text-body">${percent.toFixed(1)}%</span>
        </div>
      `;
      chartLegend.appendChild(rowDiv);
    });
  }

  // --- Text Extraction / Parse Data ---

  function parseRawText() {
    const val = textareaPaste.value.trim();
    if (!val) return;

    const lines = val.split("\n");
    const parsed = [];

    lines.forEach((line) => {
      // Clean lines and split by delimiters (comma, tab, colon, or space-separated)
      let parts = [];
      if (line.includes(",")) {
        parts = line.split(",");
      } else if (line.includes("\t")) {
        parts = line.split("\t");
      } else if (line.includes(":")) {
        parts = line.split(":");
      } else {
        // Find last space followed by a number
        const match = line.match(/(.+)\s+(\d+(\.\d+)?)\s*$/);
        if (match) {
          parts = [match[1], match[2]];
        }
      }

      if (parts.length >= 2) {
        const label = parts[0].trim();
        const valueNum = parseFloat(parts[1].trim());
        if (!isNaN(valueNum) && label) {
          parsed.push({ label, value: valueNum });
        }
      } else if (parts.length === 1) {
        // Just numbers listed
        const valueNum = parseFloat(parts[0].trim());
        if (!isNaN(valueNum)) {
          parsed.push({ label: `Slice ${parsed.length + 1}`, value: valueNum });
        }
      }
    });

    if (parsed.length > 0) {
      chartData = parsed.map((item, index) => ({
        label: item.label,
        value: item.value,
        color: getColor(index),
      }));

      syncManualRowsUI();
      triggerRender();
      switchTab("manual");
      textareaPaste.value = "";
      showToast("Data extracted successfully!");
    } else {
      showToast("Could not extract any data. Check formatting!");
    }
  }

  // --- File Drag & Drop Setup ---

  function setupFileDropzone() {
    ["dragenter", "dragover"].forEach((eventName) => {
      dropzone.addEventListener(
        eventName,
        (e) => {
          e.preventDefault();
          dropzone.classList.remove("bg-canvas-soft-2");
          dropzone.classList.add("bg-canvas-soft-2", "border-hairline-strong");
        },
        false,
      );
    });

    ["dragleave", "drop"].forEach((eventName) => {
      dropzone.addEventListener(
        eventName,
        (e) => {
          e.preventDefault();
          dropzone.classList.remove("border-hairline-strong");
        },
        false,
      );
    });

    dropzone.addEventListener("drop", (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      if (files.length > 0) {
        handleImportFile(files[0]);
      }
    });

    dropzone.addEventListener("click", () => {
      fileInput.click();
    });

    fileInput.addEventListener("change", (e) => {
      if (e.target.files.length > 0) {
        handleImportFile(e.target.files[0]);
      }
    });
  }

  async function handleImportFile(file) {
    fileError.classList.add("hidden");
    const name = file.name.toLowerCase();

    if (name.endsWith(".csv")) {
      const reader = new FileReader();
      reader.onload = (e) => {
        parseCSVText(e.target.result);
      };
      reader.readAsText(file);
    } else if (name.endsWith(".xlsx") || name.endsWith(".xls")) {
      // Dynamic load SheetJS and parse
      showToast("Loading spreadsheet parser…");
      try {
        const parsed = await parseXLSX(file);
        if (parsed && parsed.length > 0) {
          chartData = parsed.map((item, index) => ({
            label: item.label,
            value: item.value,
            color: getColor(index),
          }));
          syncManualRowsUI();
          triggerRender();
          switchTab("manual");
          showToast("Import completed!");
        } else {
          throw new Error("No valid columns found");
        }
      } catch (err) {
        console.error(err);
        fileError.textContent = `Error parsing XLSX: ${err.message || "File format unsupported"}`;
        fileError.classList.remove("hidden");
      }
    } else {
      fileError.textContent =
        "Unsupported file format! Upload a .csv or .xlsx file.";
      fileError.classList.remove("hidden");
    }
  }

  function parseCSVText(text) {
    const lines = text.split("\n");
    const parsed = [];

    lines.forEach((line) => {
      const row = line.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/); // smart comma-split handling quotes
      if (row.length >= 2) {
        const label = row[0].replace(/"/g, "").trim();
        const val = parseFloat(row[1].trim());
        if (!isNaN(val) && label) {
          parsed.push({ label, value: val });
        }
      }
    });

    if (parsed.length > 0) {
      chartData = parsed.map((item, index) => ({
        label: item.label,
        value: item.value,
        color: getColor(index),
      }));
      syncManualRowsUI();
      triggerRender();
      switchTab("manual");
      showToast("CSV imported!");
    } else {
      fileError.textContent =
        "No columns detected. Make sure Column 1 is Name and Column 2 is Number.";
      fileError.classList.remove("hidden");
    }
  }

  async function parseXLSX(file) {
    if (typeof window.XLSX === "undefined") {
      // Dynamically load CDN script
      await new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src =
          "https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js";
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = window.XLSX.read(data, { type: "array" });
          const firstSheetName = workbook.SheetNames[0];
          const worksheet = workbook.Sheets[firstSheetName];
          const json = window.XLSX.utils.sheet_to_json(worksheet, {
            header: 1,
          });

          const parsedData = [];
          json.forEach((row) => {
            if (row.length >= 2) {
              const label = String(row[0]).replace(/"/g, "").trim();
              const val = parseFloat(row[1]);
              if (!isNaN(val) && label !== "") {
                parsedData.push({ label, value: val });
              }
            }
          });
          resolve(parsedData);
        } catch (e) {
          reject(e);
        }
      };
      reader.onerror = reject;
      reader.readAsArrayBuffer(file);
    });
  }

  // --- Exports (SVG, PNG, PDF) ---

  function serializeSvgElement(svgClone) {
    const serializer = new XMLSerializer();
    let svgString = serializer.serializeToString(svgClone);
    
    const style = getComputedStyle(svgViewport);
    const resolveFont = (varName, fallback) => {
      const val = style.getPropertyValue(varName).trim();
      if (!val) return fallback;
      return val.replace(/"([^"]+)"/g, '$1');
    };
    svgString = svgString.replace(/var\(--font-sans\)/g, resolveFont("--font-sans", "Inter, system-ui, sans-serif"));
    svgString = svgString.replace(/&(?!(amp|lt|gt|quot|apos|#\d+|#x[0-9a-fA-F]+);)/g, "&amp;");
    return svgString;
  }

  function serializeSvg(svgEl) {
    const svgClone = svgEl.cloneNode(true);
    const vw = svgEl.viewBox?.baseVal?.width || 720;
    const vh = svgEl.viewBox?.baseVal?.height || 520;
    svgClone.setAttribute("width", vw.toString());
    svgClone.setAttribute("height", vh.toString());
    
    // Clean root attributes for standalone SVG export (removes overlay/off-screen positioning)
    svgClone.removeAttribute("style");
    svgClone.removeAttribute("class");
    svgClone.removeAttribute("id");
    svgClone.setAttribute("xmlns", "http://www.w3.org/2000/svg");

    return serializeSvgElement(svgClone);
  }

  function prepareSvgForExport(keepOverlayOnly = false) {
    if (chartConfig.is3D && three3DInstance && !keepOverlayOnly) {
      // 1. High-resolution capture (1440x1040 at 2x) from Three.js WebGL canvas matching current camera position, rotation, and angle
      const exportW = 1440;
      const exportH = 1040;
      const dataUrl = three3DInstance.captureImage(exportW, exportH);

      // 2. Clone the live SVG viewport (which already contains Title, Subtitle, Legend, Source,
      // and dynamic 3D-projected labels at the exact matching positions)
      const svgClone = svgViewport.cloneNode(true);
      const vw = svgViewport.viewBox?.baseVal?.width || 720;
      const vh = svgViewport.viewBox?.baseVal?.height || 520;
      svgClone.setAttribute("width", vw.toString());
      svgClone.setAttribute("height", vh.toString());
      svgClone.removeAttribute("style");
      svgClone.removeAttribute("class");
      svgClone.removeAttribute("id");
      svgClone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
      svgClone.setAttribute("xmlns:xlink", "http://www.w3.org/1999/xlink");

      // 3. Ensure defs block exists
      let defs = svgClone.querySelector("defs");
      if (!defs) {
        defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
        svgClone.insertBefore(defs, svgClone.firstChild);
      }

      // 4. Background rect (if not transparent)
      const bg = chartConfig.backgroundColor !== undefined ? chartConfig.backgroundColor : "#ffffff";
      let bgRect = null;
      if (bg && bg.includes("linear-gradient")) {
        const matches = bg.match(/#[0-9a-fA-F]{3,8}/g);
        if (matches && matches.length >= 2) {
          const grad = document.createElementNS("http://www.w3.org/2000/svg", "linearGradient");
          grad.setAttribute("id", "chart-export-bg-gradient");
          grad.setAttribute("x1", "0%");
          grad.setAttribute("y1", "0%");
          grad.setAttribute("x2", "100%");
          grad.setAttribute("y2", "100%");
          matches.forEach((color, i) => {
            const stop = document.createElementNS("http://www.w3.org/2000/svg", "stop");
            const offset = i === 0 ? "0%" : i === matches.length - 1 ? "100%" : `${(i / (matches.length - 1)) * 100}%`;
            stop.setAttribute("offset", offset);
            stop.setAttribute("stop-color", color);
            grad.appendChild(stop);
          });
          defs.appendChild(grad);
          bgRect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
          bgRect.setAttribute("width", "100%");
          bgRect.setAttribute("height", "100%");
          bgRect.setAttribute("fill", "url(#chart-export-bg-gradient)");
        }
      } else if (bg && bg !== "transparent") {
        bgRect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
        bgRect.setAttribute("width", "100%");
        bgRect.setAttribute("height", "100%");
        bgRect.setAttribute("fill", bg);
      }

      // 5. Embedded 3D render image element (positioned behind text & labels)
      const imgEl = document.createElementNS("http://www.w3.org/2000/svg", "image");
      imgEl.setAttribute("href", dataUrl);
      imgEl.setAttributeNS("http://www.w3.org/1999/xlink", "xlink:href", dataUrl);
      imgEl.setAttribute("x", "0");
      imgEl.setAttribute("y", "0");
      imgEl.setAttribute("width", vw.toString());
      imgEl.setAttribute("height", vh.toString());
      imgEl.setAttribute("preserveAspectRatio", "xMidYMid meet");

      // Insert background and 3D image right after defs (before titles, labels, and legends)
      const insertTarget = defs.nextSibling;
      if (bgRect) {
        svgClone.insertBefore(bgRect, insertTarget);
      }
      svgClone.insertBefore(imgEl, insertTarget);

      return serializeSvgElement(svgClone);
    } else if (chartConfig.is3D && !three3DInstance && !keepOverlayOnly) {
      // Fallback if WebGL 3D instance is not available
      const tempSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      tempSvg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
      tempSvg.style.position = "absolute";
      tempSvg.style.left = "-9999px";
      tempSvg.style.top = "0";
      tempSvg.style.width = "720px";
      tempSvg.style.height = "520px";
      document.body.appendChild(tempSvg);
      renderChart(tempSvg, chartData, { ...chartConfig, isWebGL3D: false });
      const res = serializeSvg(tempSvg);
      document.body.removeChild(tempSvg);
      return res;
    }
    return serializeSvg(svgViewport);
  }

  function svgToCanvas(svgString) {
    return new Promise((resolve, reject) => {
      // Use data URI instead of blob URL — avoids canvas taint issues
      // on browsers that treat blob: URLs as cross-origin
      const encoded = encodeURIComponent(svgString)
        .replace(/'/g, '%27')
        .replace(/"/g, '%22');
      const url = `data:image/svg+xml,${encoded}`;

      const img = new Image();
      img.onload = () => {
        const vw = svgViewport.viewBox.baseVal.width || 720;
        const vh = svgViewport.viewBox.baseVal.height || 520;
        const scale = 2;

        const canvas = document.createElement("canvas");
        canvas.width = vw * scale;
        canvas.height = vh * scale;
        const ctx = canvas.getContext("2d");
        ctx.scale(scale, scale);

        // In 3D overlay mode or transparent bg, keep canvas transparent
        const isBgTransparent = chartConfig.backgroundColor === 'transparent' || chartConfig.is3D;
        if (!isBgTransparent) {
          const canvasBg = chartConfig.backgroundColor.includes('linear-gradient') ? '#ffffff' : (chartConfig.backgroundColor || '#ffffff');
          ctx.fillStyle = canvasBg;
          ctx.fillRect(0, 0, vw, vh);
        }
        ctx.drawImage(img, 0, 0, vw, vh);

        resolve({ canvas, ctx, vw, vh });
      };
      img.onerror = (e) => {
        console.error("svgToCanvas: image load failed", e);
        reject(new Error("SVG image failed to load"));
      };
      img.src = url;
    });
  }

  function downloadSvg() {
    try {
      const svgString = prepareSvgForExport(false);
      const blob = new Blob([svgString], { type: "image/svg+xml;charset=utf-8" });
      const url = URL.createObjectURL(blob);

      const a = document.createElement("a");
      a.href = url;
      a.download = `${chartConfig.title || "pie-chart"}.svg`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      showToast("SVG download triggered!");
    } catch (err) {
      console.error(err);
      showToast("Failed to export SVG.");
    }
  }

  async function downloadPng() {
    try {
      showToast("Rendering PNG…");
      
      if (chartConfig.is3D && three3DInstance) {
        // Capture from Three.js WebGL canvas (high-res 1440x1040 at 2x)
        const exportW = 1440;
        const exportH = 1040;
        const dataUrl = three3DInstance.captureImage(exportW, exportH);
        
        // Capture the SVG overlay (with Title, Subtitle, Labels, Legend, Source)
        const svgString = prepareSvgForExport(true);
        const { canvas: svgCanvas } = await svgToCanvas(svgString);
        
        const img = new Image();
        img.onload = () => {
          const exportCanvas = document.createElement('canvas');
          exportCanvas.width = exportW;
          exportCanvas.height = exportH;
          const ctx = exportCanvas.getContext('2d');
          
          // Draw background
          const bg = chartConfig.backgroundColor || '#ffffff';
          if (bg !== 'transparent') {
            ctx.fillStyle = bg.includes('linear-gradient') ? '#ffffff' : bg;
            ctx.fillRect(0, 0, exportW, exportH);
          }
          
          // 1. Draw 3D chart
          ctx.drawImage(img, 0, 0, exportW, exportH);
          
          // 2. Draw SVG overlay (Title, Subtitle, Labels, Legend, Source)
          ctx.drawImage(svgCanvas, 0, 0, exportW, exportH);
          
          const pngURL = exportCanvas.toDataURL("image/png");
          const a = document.createElement("a");
          a.href = pngURL;
          a.download = `${chartConfig.title || "pie-chart"}-3d.png`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          showToast("PNG downloaded!");
        };
        img.src = dataUrl;
      } else {
        const svgString = prepareSvgForExport(false);
        const { canvas } = await svgToCanvas(svgString);

        const pngURL = canvas.toDataURL("image/png");
        const a = document.createElement("a");
        a.href = pngURL;
        a.download = `${chartConfig.title || "pie-chart"}.png`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        showToast("PNG downloaded!");
      }
    } catch (err) {
      console.error("PNG export error:", err);
      showToast("PNG render failed: " + (err.message || "unknown error"));
    }
  }

  async function copySvgToClipboard() {
    try {
      const svgString = prepareSvgForExport(false);
      await navigator.clipboard.writeText(svgString);
      showToast("SVG code copied to clipboard!");
    } catch (err) {
      console.error(err);
      showToast("Failed to copy to clipboard.");
    }
  }

  async function downloadPdf() {
    showToast("Generating PDF…");
    try {
      // Dynamically load jsPDF from CDN
      if (typeof window.jspdf === "undefined") {
        await new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.src = "https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js";
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }

      const { jsPDF } = window.jspdf;
      
      let imgData, vw, vh;
      
      if (chartConfig.is3D && three3DInstance) {
        vw = 1440;
        vh = 1040;
        const dataUrl = three3DInstance.captureImage(vw, vh);
        
        // Capture SVG overlay
        const svgString = prepareSvgForExport(true);
        const { canvas: svgCanvas } = await svgToCanvas(svgString);

        const img = new Image();
        await new Promise((resolve) => {
          img.onload = resolve;
          img.src = dataUrl;
        });
        
        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = vw;
        exportCanvas.height = vh;
        const ctx = exportCanvas.getContext('2d');
        
        const bg = chartConfig.backgroundColor || '#ffffff';
        if (bg !== 'transparent') {
          ctx.fillStyle = bg.includes('linear-gradient') ? '#ffffff' : bg;
          ctx.fillRect(0, 0, vw, vh);
        }
        
        // Composite 3D chart + SVG overlay
        ctx.drawImage(img, 0, 0, vw, vh);
        ctx.drawImage(svgCanvas, 0, 0, vw, vh);
        
        imgData = exportCanvas.toDataURL("image/png");
      } else {
        const svgString = prepareSvgForExport(false);
        const result = await svgToCanvas(svgString);
        imgData = result.canvas.toDataURL("image/png");
        vw = result.vw;
        vh = result.vh;
      }

      // Determine best orientation for A4
      const isLandscape = vw > vh;
      const pdf = new jsPDF({
        orientation: isLandscape ? "landscape" : "portrait",
        unit: "mm",
        format: "a4",
      });

      const pdfWidth = pdf.internal.pageSize.getWidth();
      const pdfHeight = pdf.internal.pageSize.getHeight();
      const margin = 10;

      let drawWidth = pdfWidth - margin * 2;
      let drawHeight = drawWidth * (vh / vw);

      if (drawHeight > pdfHeight - margin * 2) {
        drawHeight = pdfHeight - margin * 2;
        drawWidth = drawHeight * (vw / vh);
      }

      const xOffset = (pdfWidth - drawWidth) / 2;
      const yOffset = (pdfHeight - drawHeight) / 2;

      pdf.addImage(imgData, "PNG", xOffset, yOffset, drawWidth, drawHeight);
      pdf.save(`${chartConfig.title || "pie-chart"}.pdf`);

      showToast("PDF downloaded!");
    } catch (err) {
      console.error("PDF export error:", err);
      showToast("PDF failed: " + (err.message || "unknown error"));
    }
  }

  // --- Decentralized Share Hash Encoding ---

  function generateShareLink() {
    const payload = {
      d: chartData.map((row) => ({ l: row.label, v: row.value, c: row.color })),
      c: {
        d: chartConfig.isDonut ? 1 : 0,
        hr: chartConfig.donutHoleRadius,
        i3d: chartConfig.is3D ? 1 : 0,
        t: chartConfig.tilt,
        cs: chartConfig.chartSize ?? 100,
        h: chartConfig.height3D,
        ti: chartConfig.title,
        sub: chartConfig.subtitle,
        sti: chartConfig.showTitle !== false ? 1 : 0,
        ssub: chartConfig.showSubtitle !== false ? 1 : 0,
        sleg: chartConfig.showLegend !== false ? 1 : 0,
        slb: chartConfig.showLabels !== false ? 1 : 0,
        ho: chartConfig.disableHoverOffset ? 1 : 0,
        f: chartConfig.fontFamily,
        tc: chartConfig.titleColor,
        sc: chartConfig.subtitleColor,
        lc: chartConfig.labelColor,
        bg: chartConfig.backgroundColor,
        lm: chartConfig.labelMode,
        src: chartConfig.source,
        tfs: chartConfig.titleFontSize,
        sfs: chartConfig.subtitleFontSize,
        lfs: chartConfig.labelFontSize,
        srfs: chartConfig.sourceFontSize,
        srco: chartConfig.sourceColor,
      },
    };

    try {
      const base64 = btoa(
        unescape(encodeURIComponent(JSON.stringify(payload))),
      );
      const shareUrl = `${location.protocol}//${location.host}${location.pathname}#state=${base64}`;
      shareLinkInput.value = shareUrl;
    } catch (e) {
      console.error("Failed to encode share link", e);
    }
  }

  function copyShareLink() {
    shareLinkInput.select();
    shareLinkInput.setSelectionRange(0, 99999);
    try {
      navigator.clipboard.writeText(shareLinkInput.value);
      showToast(linkCopiedMsg);
    } catch (err) {
      showToast("Failed to copy link.");
    }
  }

  function loadUrlOrStorageState() {
    // Check hash first
    const hash = location.hash;
    if (hash && hash.startsWith("#state=")) {
      try {
        const payloadBase64 = hash.substring(7);
        const jsonStr = decodeURIComponent(escape(atob(payloadBase64)));
        const state = JSON.parse(jsonStr);

        if (state.d && Array.isArray(state.d)) {
          chartData = state.d.map((item) => ({
            label: item.l,
            value: item.v,
            color: item.c,
          }));
        }

        if (state.c) {
          chartConfig = {
            isDonut: state.c.d === 1,
            donutHoleRadius: state.c.hr ?? 0.5,
            is3D: state.c.i3d === 1,
            tilt: state.c.t ?? 0.55,
            chartSize: state.c.cs ?? 100,
            height3D: state.c.h ?? 30,
            title: state.c.ti ?? "",
            subtitle: state.c.sub ?? "",
            showTitle: state.c.sti === undefined ? true : state.c.sti === 1,
            showSubtitle: state.c.ssub === undefined ? true : state.c.ssub === 1,
            showLabels: state.c.slb === undefined ? true : state.c.slb === 1,
            showLegend: state.c.sleg === undefined ? true : state.c.sleg === 1,
            disableHoverOffset: state.c.ho === 1,
            fontFamily: state.c.f ?? "Inter",
            titleColor: state.c.tc ?? "#171717",
            subtitleColor: state.c.sc ?? "#666666",
            labelColor: state.c.lc ?? "#171717",
            backgroundColor: state.c.bg ?? "#ffffff",
            labelMode: state.c.lm ?? "label-percent",
            source: state.c.src ?? "",
            titleFontSize: state.c.tfs ?? 15,
            subtitleFontSize: state.c.sfs ?? 10.5,
            labelFontSize: state.c.lfs ?? 9.5,
            sourceFontSize: state.c.srfs ?? 8,
            sourceColor: state.c.srco ?? "#666666",
          };

          // Sync UI controls with the URL state
          syncUiFromConfig();
        }

        // Clean up hash in location bar to keep it tidy
        history.replaceState(null, "", location.pathname);
        showToast("Shared chart loaded!");
      } catch (err) {
        console.error("Failed to parse URL hash state", err);
        showToast("Failed to parse shared link.");
      }
    } else if (wsContainer?.dataset?.initialData) {
      // Prioritize programmatic starter / preset initialData for templates
      try {
        const rawPreset = wsContainer.dataset.initialData;
        const parsedData = JSON.parse(rawPreset);
        if (Array.isArray(parsedData) && parsedData.length > 0) {
          chartData = parsedData.map((item, index) => ({
            label: item.label,
            value: Number(item.value) || 0,
            color: item.color || getColor(index),
          }));

          const customTitle = wsContainer.dataset.initialTitle;
          const customSubtitle = wsContainer.dataset.initialSubtitle;
          if (customTitle) chartConfig.title = customTitle;
          if (customSubtitle) chartConfig.subtitle = customSubtitle;

          syncUiFromConfig();
        }
      } catch (err) {
        console.error("Failed to parse initial preset data", err);
      }
    } else {
      // Fallback: load last draft from localStorage scoped by language
      try {
        const sessionKey = `pie_chart_last_session_${currentLang}`;
        const lastSession = localStorage.getItem(sessionKey);
        if (lastSession) {
          const parsed = JSON.parse(lastSession);
          chartData = parsed.data;
          chartConfig = parsed.config;
          
          // Apply safe defaults for older/corrupted configs
          chartConfig.isDonut = !!chartConfig.isDonut;
          chartConfig.donutHoleRadius = chartConfig.donutHoleRadius ?? 0.5;
          chartConfig.is3D = !!chartConfig.is3D;
          chartConfig.tilt = chartConfig.tilt ?? 0.55;
          chartConfig.chartSize = chartConfig.chartSize ?? 100;
          chartConfig.height3D = chartConfig.height3D ?? 30;
          chartConfig.title = chartConfig.title ?? defaultTitle;
          chartConfig.subtitle = chartConfig.subtitle ?? defaultSubtitle;
          chartConfig.showTitle = chartConfig.showTitle ?? true;
          chartConfig.showSubtitle = chartConfig.showSubtitle ?? true;
          chartConfig.showLabels = chartConfig.showLabels ?? true;
          chartConfig.showLegend = chartConfig.showLegend ?? true;
          chartConfig.disableHoverOffset = !!chartConfig.disableHoverOffset;
          chartConfig.fontFamily = chartConfig.fontFamily ?? "Inter";
          chartConfig.titleColor = chartConfig.titleColor ?? "#171717";
          chartConfig.subtitleColor = chartConfig.subtitleColor ?? "#666666";
          chartConfig.labelColor = chartConfig.labelColor ?? "#171717";
          if (!chartConfig.isExplicitBg) {
            chartConfig.backgroundColor = "#ffffff";
          } else {
            chartConfig.backgroundColor = chartConfig.backgroundColor ?? "#ffffff";
          }
          chartConfig.labelMode = chartConfig.labelMode ?? "label-percent";
          chartConfig.source = chartConfig.source ?? "";
          chartConfig.titleFontSize = chartConfig.titleFontSize ?? 15;
          chartConfig.subtitleFontSize = chartConfig.subtitleFontSize ?? 10.5;
          chartConfig.labelFontSize = chartConfig.labelFontSize ?? 9.5;
          chartConfig.sourceFontSize = chartConfig.sourceFontSize ?? 8;
          chartConfig.sourceColor = chartConfig.sourceColor ?? "#666666";
          
          syncUiFromConfig();
        }
      } catch (e) {}
    }

    // If initial3D was preset on container (and not overridden by shared hash), enforce 3D isometric mode
    const isPreset3D = wsContainer?.dataset?.initial3d === "true" || wsContainer?.dataset?.["initial-3d"] === "true" || wsContainer?.dataset?.initialIs3d === "true" || wsContainer?.getAttribute("data-initial-3d") === "true";
    if (isPreset3D && (!hash || !hash.startsWith("#state="))) {
      chartConfig.is3D = true;
      chartConfig.tilt = chartConfig.tilt ?? 0.6;
      chartConfig.height3D = chartConfig.height3D ?? 35;
      syncUiFromConfig();
    }

    // Auto save last state before unloading page (scoped by language)
    window.addEventListener("beforeunload", () => {
      try {
        const sessionKey = `pie_chart_last_session_${currentLang}`;
        localStorage.setItem(
          sessionKey,
          JSON.stringify({
            data: chartData,
            config: chartConfig,
          }),
        );
      } catch (e) {}
    });
  }

  function resetChartToDefaults() {
    // 1. Find all slice group elements in the SVG viewport
    const slices = svgViewport.querySelectorAll(".slice-group");

    // 2. Dispatch a mouseleave event to restore them to center and hide tooltips
    slices.forEach((slice) => {
      const event = new MouseEvent("mouseleave");
      slice.dispatchEvent(event);
    });

    // 3. Reset Three.js camera if in 3D mode
    if (three3DInstance && three3DInstance.resetCamera) {
      three3DInstance.resetCamera();
    }

    showToast("Chart views restored!");
  }

  // --- Local drafts history ---

  function saveDraft() {
    const name = draftNameInput.value.trim();
    if (!name) {
      showToast(enterDraftNameMsg);
      return;
    }

    try {
      const draftsStr = localStorage.getItem("pie_chart_drafts") || "[]";
      const drafts = JSON.parse(draftsStr);

      // Check duplicate
      const existIndex = drafts.findIndex(
        (d) => d.name.toLowerCase() === name.toLowerCase(),
      );
      const draftObj = {
        name: name,
        date: new Date().toLocaleDateString(),
        data: chartData,
        config: chartConfig,
      };

      if (existIndex >= 0) {
        drafts[existIndex] = draftObj;
      } else {
        drafts.push(draftObj);
      }

      localStorage.setItem("pie_chart_drafts", JSON.stringify(drafts));
      draftNameInput.value = "";
      loadDraftsHistory();
      showToast(`${name}: ${draftSavedMsg}`);
    } catch (err) {
      console.error(err);
      showToast("Failed to save draft.");
    }
  }

  function loadDraftsHistory() {
    draftsList.innerHTML = "";
    try {
      const draftsStr = localStorage.getItem("pie_chart_drafts") || "[]";
      const drafts = JSON.parse(draftsStr);

      if (drafts.length === 0) {
        draftsList.innerHTML = `
          <span class="font-sans text-[11px] text-mute select-none py-1">${noDraftsMsg}</span>
        `;
        return;
      }

      drafts.forEach((draft, idx) => {
        const row = document.createElement("div");
        row.className =
          "flex items-center justify-between border border-hairline bg-canvas-soft-2 p-1.5 rounded-sm hover:bg-canvas transition-colors";

        row.innerHTML = `
          <button 
            type="button" 
            class="load-draft-btn flex-grow min-w-0 text-left font-sans text-xs text-body hover:text-ink truncate max-w-[150px] font-medium cursor-pointer"
            title="Load draft: ${escapeHTML(draft.name)}"
          >
            ${escapeHTML(draft.name)}
          </button>
          <div class="flex items-center gap-2">
            <span class="font-mono text-[9px] text-mute">${draft.date}</span>
            <button 
              type="button" 
              class="delete-draft-btn w-6 h-6 inline-flex items-center justify-center text-mute hover:text-error-deep rounded-sm hover:bg-error-soft/30 transition-colors cursor-pointer"
              aria-label="Delete draft ${escapeHTML(draft.name)}"
            >
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M1.5 3.5h11M11.5 3.5v9a1 1 0 01-1 1h-7a1 1 0 01-1-1v-9m2 0V2a1 1 0 011-1h3a1 1 0 011 1v1.5M5.5 6.5v4M8.5 6.5v4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        `;

        const loadBtn = row.querySelector(".load-draft-btn");
        const deleteBtn = row.querySelector(".delete-draft-btn");

        loadBtn.addEventListener("click", () => {
          // Deep clone the draft data & config to prevent reference sharing bugs
          chartData = JSON.parse(JSON.stringify(draft.data));
          chartConfig = JSON.parse(JSON.stringify(draft.config));

          // Apply safe defaults for older/corrupted configs
          chartConfig.isDonut = !!chartConfig.isDonut;
          chartConfig.donutHoleRadius = chartConfig.donutHoleRadius ?? 0.5;
          chartConfig.is3D = !!chartConfig.is3D;
          chartConfig.tilt = chartConfig.tilt ?? 0.55;
          chartConfig.chartSize = chartConfig.chartSize ?? 100;
          chartConfig.height3D = chartConfig.height3D ?? 30;
          chartConfig.title = chartConfig.title ?? "";
          chartConfig.subtitle = chartConfig.subtitle ?? "";
          chartConfig.showTitle = chartConfig.showTitle ?? true;
          chartConfig.showSubtitle = chartConfig.showSubtitle ?? true;
          chartConfig.showLabels = chartConfig.showLabels ?? true;
          chartConfig.showLegend = chartConfig.showLegend ?? true;
          chartConfig.disableHoverOffset = !!chartConfig.disableHoverOffset;
          chartConfig.fontFamily = chartConfig.fontFamily ?? "Inter";
          chartConfig.titleColor = chartConfig.titleColor ?? "#171717";
          chartConfig.subtitleColor = chartConfig.subtitleColor ?? "#666666";
          chartConfig.labelColor = chartConfig.labelColor ?? "#171717";
          chartConfig.backgroundColor = chartConfig.backgroundColor ?? "#ffffff";
          chartConfig.labelMode = chartConfig.labelMode ?? "label-percent";
          chartConfig.source = chartConfig.source ?? "";
          chartConfig.titleFontSize = chartConfig.titleFontSize ?? 15;
          chartConfig.subtitleFontSize = chartConfig.subtitleFontSize ?? 10.5;
          chartConfig.labelFontSize = chartConfig.labelFontSize ?? 9.5;
          chartConfig.sourceFontSize = chartConfig.sourceFontSize ?? 8;
          chartConfig.sourceColor = chartConfig.sourceColor ?? "#666666";

          syncUiFromConfig();
          syncManualRowsUI();
          triggerRender();
          showToast(`Loaded draft: "${draft.name}"`);
        });

        deleteBtn.addEventListener("click", () => {
          drafts.splice(idx, 1);
          localStorage.setItem("pie_chart_drafts", JSON.stringify(drafts));
          loadDraftsHistory();
          showToast("Draft deleted.");
        });

        draftsList.appendChild(row);
      });
    } catch (e) {
      console.error(e);
    }
  }

  // --- Toast notifications ---
  let toastTimeout;
  function showToast(msg) {
    clearTimeout(toastTimeout);
    toastMsg.textContent = msg;

    // Animate in
    toastNode.classList.remove("translate-y-12", "opacity-0");
    toastNode.classList.add("translate-y-0", "opacity-100");

    toastTimeout = setTimeout(() => {
      toastNode.classList.remove("translate-y-0", "opacity-100");
      toastNode.classList.add("translate-y-12", "opacity-0");
    }, 2500);
  }

  // --- Run Init ---
  init();
</script>

