  const input3dHeight = document.getElementById("input-3d-height");
  const donutHoleVal = document.getElementById("donut-hole-val");
  const chartSizeVal = document.getElementById("chart-size-val");
  const heightVal = document.getElementById("3d-height-val");

  // Manual list
