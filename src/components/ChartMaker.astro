---
// ChartMaker.astro - The core application interface for the Pie Chart Maker
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { SupportedLanguage } from "../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
  initialData?: Array<{ label: string; value: number; color?: string }>;
  initialTitle?: string;
  initialSubtitle?: string;
  initial3D?: boolean;
  translations?: Record<string, string>;
}

const {
  lang,
  initialData,
  initialTitle,
  initialSubtitle,
  initial3D,
  translations = {},
} = Astro.props;

const urlLang = getLangFromUrl(Astro.url);
const currentLang = lang || urlLang;
const defaultT = useTranslations(currentLang);
const t = (key: string) => translations[key] ?? defaultT(key as any);
---

<div
  id="workspace-container"
  class="max-w-[1400px] mx-auto px-4 sm:px-6 py-8 md:py-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
  data-lang={currentLang}
  data-initial-3d={initial3D ? "true" : undefined}
  data-initial-is-3d={initial3D ? "true" : undefined}
  data-initial-data={initialData ? JSON.stringify(initialData) : undefined}
  data-initial-title={initialTitle || ""}
  data-initial-subtitle={initialSubtitle || ""}
  data-default-title={t("default.title")}
  data-default-subtitle={t("default.subtitle")}
  data-default-slice1={t("default.slice1")}
  data-default-slice2={t("default.slice2")}
  data-default-slice3={t("default.slice3")}
  data-default-slice4={t("default.slice4")}
  data-slice-prefix={t("app.slicePrefix")}
  data-slice-placeholder={t("app.slicePlaceholder")}
  data-val-placeholder={t("app.valPlaceholder")}
  data-delete-slice={t("app.deleteSlice")}
  data-no-data={t("app.noData")}
  data-untitled={t("app.untitled")}
  data-link-copied={t("app.linkCopied")}
  data-draft-saved={t("app.draftSaved")}
  data-enter-draft-name={t("app.enterDraftName")}
  data-no-drafts={t("app.noDrafts")}
>
  <!-- Left Column: Inputs & Controls (6 Cols on desktop) -->
  <div class="lg:col-span-6 flex flex-col gap-6 order-2 lg:order-1">
    <!-- Data Input Mode Panel -->
    <div
      class="bg-canvas rounded-md border border-hairline shadow-lvl2 overflow-hidden"
    >
      <!-- Tab Header -->
      <div
        class="flex border-b border-hairline bg-canvas-soft-2 px-2 pt-2 gap-1 overflow-x-auto whitespace-nowrap scrollbar-none"
        role="tablist"
        aria-label="Data Input Sources"
      >
        <button
          id="tab-manual"
          class="px-4 py-2 text-xs font-sans font-medium rounded-t-sm border border-transparent border-b-0 -mb-[1px] hover:text-ink transition-colors cursor-pointer select-none text-ink bg-canvas border-hairline! active-tab shrink-0"
          role="tab"
          aria-selected="true"
          aria-controls="panel-manual"
        >
          {t("app.tabManual")}
        </button>
        <button
          id="tab-paste"
          class="px-4 py-2 text-xs font-sans font-medium rounded-t-sm border border-transparent border-b-0 -mb-[1px] text-body hover:text-ink transition-colors cursor-pointer select-none shrink-0"
          role="tab"
          aria-selected="false"
          aria-controls="panel-paste"
        >
          {t("app.tabPaste")}
        </button>
        <button
          id="tab-upload"
          class="px-4 py-2 text-xs font-sans font-medium rounded-t-sm border border-transparent border-b-0 -mb-[1px] text-body hover:text-ink transition-colors cursor-pointer select-none shrink-0"
          role="tab"
          aria-selected="false"
          aria-controls="panel-upload"
        >
          {t("app.tabUpload")}
        </button>
      </div>

      <!-- Tab Panels -->
      <div class="p-6">
        <!-- Manual Tab Panel -->
        <div
          id="panel-manual"
          class="flex flex-col gap-4"
          role="tabpanel"
          aria-labelledby="tab-manual"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-sans text-sm font-semibold text-ink">
              {t("app.dataFields")}
            </h2>
            <div class="flex gap-2">
              <button
                id="btn-sort-val"
                class="inline-flex items-center justify-center h-7 px-2.5 bg-canvas border border-hairline rounded-sm text-xs font-sans text-body hover:bg-canvas-soft hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary cursor-pointer shrink-0"
                title={t("app.sortByValue")}
              >
                {t("app.sortByValue")}
              </button>
              <button
                id="btn-clear-all"
                class="inline-flex items-center justify-center h-7 px-2.5 bg-canvas border border-error-soft text-error rounded-sm text-xs font-sans hover:bg-error-soft/30 hover:text-error-deep transition-colors focus-visible:outline-2 focus-visible:outline-error cursor-pointer shrink-0"
              >
                {t("app.clearAll")}
              </button>
            </div>
          </div>

          <!-- Dynamic manual input rows container -->
          <div
            id="manual-rows-container"
            class="flex flex-col gap-2 max-h-[360px] overflow-y-auto pr-1"
          >
            <!-- Dynamic rows will be inserted here by JS -->
          </div>

          <button
            id="btn-add-row"
            class="w-full inline-flex items-center justify-center h-9 border border-dashed border-hairline-strong rounded-sm text-xs font-sans font-medium text-body hover:bg-canvas-soft hover:text-ink hover:border-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary cursor-pointer mt-2"
          >
            {t("app.addSlice")}
          </button>
        </div>

        <!-- Paste Text Tab Panel -->
        <div
          id="panel-paste"
          class="hidden flex flex-col gap-4"
          role="tabpanel"
          aria-labelledby="tab-paste"
        >
          <label
            for="paste-textarea"
            class="font-sans text-xs font-medium text-body"
          >
            {t("app.pasteLabel")}
          </label>
          <textarea
            id="paste-textarea"
            rows="6"
            class="w-full font-mono text-xs p-3 border border-hairline rounded-sm focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors"
            placeholder={t("app.pastePlaceholder")}
            spellcheck="false"
            autocomplete="off"></textarea>
          <div class="flex gap-3 justify-end">
            <button
              id="btn-parse-text"
              class="inline-flex items-center justify-center h-8 px-4 bg-primary text-on-primary rounded-sm text-xs font-sans font-medium hover:bg-primary/95 transition-colors focus-visible:outline-2 focus-visible:outline-primary cursor-pointer"
            >
              {t("app.extractUpdate")}
            </button>
          </div>
        </div>

        <!-- Upload File Tab Panel -->
        <div
          id="panel-upload"
          class="hidden flex flex-col gap-4"
          role="tabpanel"
          aria-labelledby="tab-upload"
        >
          <div
            id="dropzone"
            class="w-full border-2 border-dashed border-hairline hover:border-hairline-strong rounded-md p-8 text-center bg-canvas-soft-2 cursor-pointer transition-colors flex flex-col items-center justify-center gap-3"
            aria-label={t("app.dropzoneTitle")}
          >
            <svg
              class="text-mute w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5h10.5a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0017.25 4.5H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25z"
              ></path>
            </svg>
            <div class="flex flex-col gap-1">
              <span class="font-sans text-xs font-medium text-ink"
                >{t("app.dropzoneTitle")}</span
              >
              <span class="font-sans text-[11px] text-mute"
                >{t("app.dropzoneSubtitle")}</span
              >
            </div>
            <input
              id="file-input"
              type="file"
              accept=".csv, .xlsx, .xls"
              class="hidden"
            />
          </div>
          <div
            id="file-error"
            class="hidden font-sans text-xs text-error-deep bg-error-soft px-3 py-2 rounded-sm border border-error-soft/50"
          >
          </div>
          <div class="font-sans text-[11px] text-mute leading-relaxed">
            {t("app.fileFormatHint")}
          </div>
        </div>
      </div>
    </div>

    <!-- Chart Customization Panel -->
    <div
      class="bg-canvas p-6 md:p-8 rounded-md border border-hairline shadow-lvl2 flex flex-col gap-6"
    >
      <h2
        class="font-sans text-sm font-semibold text-ink border-b border-hairline pb-3"
      >
        {t("app.configTitle")}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Series Configuration -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label
              for="chart-title"
              class="font-sans text-xs font-medium text-body">{t("app.title")}</label
            >
            <input
              id="chart-title"
              type="text"
              class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors"
              placeholder={t("app.titlePlaceholder")}
              autocomplete="off"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label
              for="chart-subtitle"
              class="font-sans text-xs font-medium text-body"
              >{t("app.subtitle")}</label
            >
            <input
              id="chart-subtitle"
              type="text"
              class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors"
              placeholder={t("app.subtitlePlaceholder")}
              autocomplete="off"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label
              for="chart-source"
              class="font-sans text-xs font-medium text-body"
              >{t("app.source")}</label
            >
            <input
              id="chart-source"
              type="text"
              class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors"
              placeholder={t("app.sourcePlaceholder")}
              autocomplete="off"
            />
          </div>
        </div>

        <!-- Visual Settings -->
        <div class="flex flex-col gap-4">
          <!-- Chart Type Toggle -->
          <div class="flex flex-col gap-2">
            <span class="font-sans text-xs font-medium text-body"
              >{t("app.chartLayout")}</span
            >
            <div class="flex gap-2">
              <label
                class="flex-1 inline-flex items-center justify-center h-8 px-4 rounded-sm border border-hairline-strong bg-canvas text-ink text-xs font-sans font-medium cursor-pointer select-none text-center shadow-lvl1 transition-all has-checked:bg-primary has-checked:text-on-primary has-checked:border-primary"
              >
                <input
                  type="radio"
                  name="chart-layout"
                  value="pie"
                  checked
                  class="sr-only"
                />
                {t("app.pieChart")}
              </label>
              <label
                class="flex-1 inline-flex items-center justify-center h-8 px-4 rounded-sm border border-hairline bg-canvas text-body hover:text-ink text-xs font-sans font-medium cursor-pointer select-none text-center hover:bg-canvas-soft transition-all has-checked:bg-primary has-checked:text-on-primary has-checked:border-primary"
              >
                <input
                  type="radio"
                  name="chart-layout"
                  value="donut"
                  class="sr-only"
                />
                {t("app.donutChart")}
              </label>
            </div>
          </div>

          <!-- 3D Toggle -->
          <div
            class="flex items-center justify-between py-1 border-b border-hairline/50"
          >
            <span class="font-sans text-xs font-medium text-body"
              >{t("app.toggle3D")}</span
            >
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="toggle-3d" class="sr-only peer" />
              <div
                class="w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-hairline after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary border border-hairline"
              >
              </div>
            </label>
          </div>

          <!-- Hover Pop-out Toggle -->
          <div
            class="flex items-center justify-between py-1 border-b border-hairline/50"
          >
            <span class="font-sans text-xs font-medium text-body"
              >{t("app.togglePop")}</span
            >
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="toggle-hover-pop"
                checked
                class="sr-only peer"
              />
              <div
                class="w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-hairline after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary border border-hairline"
              >
              </div>
            </label>
          </div>

          <!-- Show Title Toggle -->
          <div
            class="flex items-center justify-between py-1 border-b border-hairline/50"
          >
            <span class="font-sans text-xs font-medium text-body"
              >{t("app.showTitle")}</span
            >
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="toggle-show-title"
                checked
                class="sr-only peer"
              />
              <div
                class="w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-hairline after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary border border-hairline"
              >
              </div>
            </label>
          </div>

          <!-- Show Subtitle Toggle -->
          <div
            class="flex items-center justify-between py-1 border-b border-hairline/50"
          >
            <span class="font-sans text-xs font-medium text-body"
              >{t("app.showSubtitle")}</span
            >
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="toggle-show-subtitle"
                checked
                class="sr-only peer"
              />
              <div
                class="w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-hairline after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary border border-hairline"
              >
              </div>
            </label>
          </div>

          <!-- Show Labels Toggle -->
          <div
            class="flex items-center justify-between py-1 border-b border-hairline/50"
          >
            <span class="font-sans text-xs font-medium text-body"
              >{t("app.showLabels")}</span
            >
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="toggle-show-labels"
                checked
                class="sr-only peer"
              />
              <div
                class="w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-hairline after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary border border-hairline"
              >
              </div>
            </label>
          </div>

          <!-- Show Bottom Legend / Index Toggle -->
          <div
            class="flex items-center justify-between py-1 border-b border-hairline/50"
          >
            <span class="font-sans text-xs font-medium text-body"
              >{t("app.showLegend")}</span
            >
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="toggle-show-legend"
                checked
                class="sr-only peer"
              />
              <div
                class="w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-hairline after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary border border-hairline"
              >
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Advanced Sliders (Tilt & Hole size) -->
      <div
        id="sliders-container"
        class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 border-t border-hairline/50"
      >
        <!-- Donut Hole radius slider -->
        <div id="slider-donut-hole-group" class="hidden flex flex-col gap-2">
          <div class="flex justify-between items-center">
            <label
              for="input-donut-hole"
              class="font-sans text-xs font-medium text-body"
              >{t("app.donutHoleSize")}</label
            >
            <span
              id="donut-hole-val"
              class="font-mono text-xs text-mute font-medium">50%</span
            >
          </div>
          <input
            id="input-donut-hole"
            type="range"
            min="20"
            max="80"
            value="50"
            class="w-full accent-primary h-1 bg-canvas-soft-2 rounded-lg cursor-pointer"
          />
        </div>

        <!-- Chart Size Slider -->
        <div id="slider-chart-size-group" class="flex flex-col gap-2">
          <div class="flex justify-between items-center">
            <label
              for="input-chart-size"
              class="font-sans text-xs font-medium text-body"
              >{t("app.chartSize")}</label
            >
            <span
              id="chart-size-val"
              class="font-mono text-xs text-mute font-medium">100%</span
            >
          </div>
          <input
            id="input-chart-size"
            type="range"
            min="50"
            max="150"
            value="100"
            class="w-full accent-primary h-1 bg-canvas-soft-2 rounded-lg cursor-pointer"
          />
        </div>

        <!-- 3D Height Slider -->
        <div id="slider-3d-height-group" class="hidden flex flex-col gap-2">
          <div class="flex justify-between items-center">
            <label
              for="input-3d-height"
              class="font-sans text-xs font-medium text-body"
              >{t("app.extrusion")}</label
            >
            <span
              id="3d-height-val"
              class="font-mono text-xs text-mute font-medium">30px</span
            >
          </div>
          <input
            id="input-3d-height"
            type="range"
            min="10"
            max="70"
            value="30"
            class="w-full accent-primary h-1 bg-canvas-soft-2 rounded-lg cursor-pointer"
          />
        </div>
      </div>

      <!-- Typography & Styling Options -->
      <div class="pt-6 border-t border-hairline/50 flex flex-col gap-6">
        <h3 class="font-sans text-xs font-semibold text-ink">{t("app.typography")}</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Left styling column -->
          <div class="flex flex-col gap-4">
            <!-- Font Family -->
            <div class="flex flex-col gap-1.5">
              <label for="font-family" class="font-sans text-xs font-medium text-body">{t("app.fontFamily")}</label>
              <select id="font-family" class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors cursor-pointer">
                <option value="Inter">Inter (Sans-Serif)</option>
                <option value="Geist">Geist (Modern Sans)</option>
                <option value="Outfit">Outfit (Premium Sans)</option>
                <option value="Playfair Display">Playfair Display (Elegant Serif)</option>
                <option value="Lora">Lora (Classic Serif)</option>
                <option value="JetBrains Mono">JetBrains Mono (Monospace)</option>
              </select>
            </div>

            <!-- Label Mode -->
            <div class="flex flex-col gap-1.5">
              <label for="label-mode" class="font-sans text-xs font-medium text-body">{t("app.labelMode")}</label>
              <select id="label-mode" class="h-9 px-3 border border-hairline rounded-sm font-sans text-xs focus:outline-none focus:border-hairline-strong bg-canvas-soft-2 focus:bg-canvas transition-colors cursor-pointer">
                <option value="label-percent">{t("app.optNamePercent")}</option>
                <option value="label-value">{t("app.optNameValue")}</option>
                <option value="label-value-percent">{t("app.optNameValuePercent")}</option>
                <option value="label">{t("app.optNameOnly")}</option>
                <option value="value">{t("app.optValueOnly")}</option>
                <option value="percent">{t("app.optPercentOnly")}</option>
                <option value="none">{t("app.optNone")}</option>
              </select>
            </div>
          </div>

          <!-- Right styling column: Typographical Settings -->
          <div class="flex flex-col gap-4">
            <!-- Typography & Colors Configuration -->
            <div class="flex flex-col gap-2">
              <span class="font-sans text-xs font-medium text-body">{t("app.typoDetails")}</span>
              <div class="flex flex-col gap-2">
                <!-- Title Font Styling -->
                <div class="flex items-center justify-between gap-2 py-1 border-b border-hairline/30">
                  <span class="font-sans text-[11px] text-mute">{t("app.titleFont")}</span>
                  <div class="flex items-center gap-1.5">
                    <select id="size-title" class="h-7 px-1.5 border border-hairline rounded-sm font-sans text-[10px] focus:outline-none bg-canvas-soft-2 cursor-pointer">
                      <option value="12">12px</option>
                      <option value="14">14px</option>
                      <option value="15" selected>15px</option>
                      <option value="16">16px</option>
                      <option value="18">18px</option>
                      <option value="20">20px</option>
                      <option value="24">24px</option>
                    </select>
                    <div class="relative w-6 h-6 rounded-sm overflow-hidden flex items-center justify-center border border-hairline cursor-pointer shrink-0">
                      <input type="color" id="color-title" class="absolute opacity-0 w-full h-full cursor-pointer" value="#171717" />
                      <div id="color-title-preview" class="w-full h-full" style="background-color: #171717"></div>
                    </div>
                    <input type="text" id="color-title-hex" class="w-14 h-7 px-1 border border-hairline rounded-sm font-mono text-[9px] focus:outline-none bg-canvas-soft-2 text-center" value="#171717" />
                  </div>
                </div>

                <!-- Subtitle Font Styling -->
                <div class="flex items-center justify-between gap-2 py-1 border-b border-hairline/30">
                  <span class="font-sans text-[11px] text-mute">{t("app.subFont")}</span>
                  <div class="flex items-center gap-1.5">
                    <select id="size-subtitle" class="h-7 px-1.5 border border-hairline rounded-sm font-sans text-[10px] focus:outline-none bg-canvas-soft-2 cursor-pointer">
                      <option value="9">9px</option>
                      <option value="10">10px</option>
                      <option value="10.5" selected>10.5px</option>
                      <option value="11">11px</option>
                      <option value="12">12px</option>
                      <option value="14">14px</option>
                    </select>
                    <div class="relative w-6 h-6 rounded-sm overflow-hidden flex items-center justify-center border border-hairline cursor-pointer shrink-0">
                      <input type="color" id="color-subtitle" class="absolute opacity-0 w-full h-full cursor-pointer" value="#666666" />
                      <div id="color-subtitle-preview" class="w-full h-full" style="background-color: #666666"></div>
                    </div>
