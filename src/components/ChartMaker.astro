<script>
  // @ts-nocheck
  import { renderChart } from "./chart-renderer.js";
  import { render3DChart } from "./chart-renderer-3d.js";

  // --- Dynamic Default Color Palette ---
  const DEFAULT_PALETTE = [
    "#0070f3", // Vercel blue
    "#7928ca", // Violet
    "#ff0080", // Pink
    "#50e3c2", // Mint/Cyan
    "#f5a623", // Warning Amber
    "#ff4d4d", // Coral Red
    "#29bc9b", // Cyan Deep
    "#00dfd8", // Teal
    "#4c2889", // Violet Deep
    "#eb367f", // Magenta
  ];

  function getColor(index) {
    return DEFAULT_PALETTE[index % DEFAULT_PALETTE.length];
  }

  function escapeHTML(str) {
    if (typeof str !== "string") return str;
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // --- Read Localized Defaults from Workspace Container ---
  const wsContainer = document.getElementById("workspace-container");
  const currentLang = wsContainer?.dataset?.lang || "en";

  const defaultTitle = wsContainer?.dataset?.defaultTitle || "Resource Allocation";
  const defaultSubtitle = wsContainer?.dataset?.defaultSubtitle || "Annual Expense Distribution";
  const defaultSlice1 = wsContainer?.dataset?.defaultSlice1 || "Marketing";
  const defaultSlice2 = wsContainer?.dataset?.defaultSlice2 || "Development";
  const defaultSlice3 = wsContainer?.dataset?.defaultSlice3 || "Operations";
  const defaultSlice4 = wsContainer?.dataset?.defaultSlice4 || "Customer Success";

  const slicePrefix = wsContainer?.dataset?.slicePrefix || "Slice";
  const slicePlaceholder = wsContainer?.dataset?.slicePlaceholder || "Slice Label…";
  const valPlaceholder = wsContainer?.dataset?.valPlaceholder || "Val";
  const deleteSliceLabel = wsContainer?.dataset?.deleteSlice || "Delete slice";
  const noDataText = wsContainer?.dataset?.noData || "No data entries to list.";
  const untitledText = wsContainer?.dataset?.untitled || "Untitled";
  const linkCopiedMsg = wsContainer?.dataset?.linkCopied || "Link copied to clipboard!";
  const draftSavedMsg = wsContainer?.dataset?.draftSaved || "Draft saved!";
  const enterDraftNameMsg = wsContainer?.dataset?.enterDraftName || "Please enter a draft name";
  const noDraftsMsg = wsContainer?.dataset?.noDrafts || "No drafts saved yet.";

  // --- State Variables ---
  let chartData = [
    { label: defaultSlice1, value: 120, color: getColor(0) },
    { label: defaultSlice2, value: 340, color: getColor(1) },
    { label: defaultSlice3, value: 90, color: getColor(2) },
    { label: defaultSlice4, value: 210, color: getColor(3) },
  ];

  let chartConfig = {
    isDonut: false,
    donutHoleRadius: 0.5,
    is3D: false,
    tilt: 0.55,
    chartSize: 100,
    height3D: 30,
    title: defaultTitle,
    subtitle: defaultSubtitle,
    showTitle: true,
    showSubtitle: true,
    showLabels: true,
    showLegend: true,
    fontFamily: "Inter",
    titleColor: "#171717",
    subtitleColor: "#666666",
    labelColor: "#171717",
    backgroundColor: "#ffffff",
    isExplicitBg: false,
    labelMode: "label-percent",
    source: "",
    titleFontSize: 15,
    subtitleFontSize: 10.5,
    labelFontSize: 9.5,
    sourceFontSize: 8,
    sourceColor: "#666666",
  };

  // --- DOM Elements ---
  const svgViewport = document.getElementById("chart-viewport");
  const threeContainer = document.getElementById("three-container");
  const viewportWrapper = document.getElementById("chart-viewport-wrapper");

  // Active Three.js instance (null when in 2D mode)
  let three3DInstance = null;

  // Headers
  const previewTitle = document.getElementById("preview-title");
  const previewSubtitle = document.getElementById("preview-subtitle");

  // Inputs
  const inputTitle = document.getElementById("chart-title");
  const inputSubtitle = document.getElementById("chart-subtitle");
  const toggle3D = document.getElementById("toggle-3d");
  const toggleHoverPop = document.getElementById("toggle-hover-pop");
  const toggleShowTitle = document.getElementById("toggle-show-title");
  const toggleShowSubtitle = document.getElementById("toggle-show-subtitle");
  const toggleShowLabels = document.getElementById("toggle-show-labels");
