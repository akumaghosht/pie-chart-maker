---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "Pie Chart Maker — Create beautiful 2D/3D charts online", 
  description = "Create, customize, and export stunning 2D/3D pie and donut charts. Upload CSV/XLSX, paste text, or manually edit data with dynamic live previews. Zero ads, serverless sharing." 
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="piechartmakerfree.com" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://piechartmakerfree.com" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
	</head>
	<body class="flex flex-col min-h-screen bg-canvas-soft text-ink">
		<!-- Skip Link for Accessibility -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:rounded-sm focus:outline-none">
			Skip to main content
		</a>

		<!-- Vercel Nav Bar -->
		<header class="sticky top-0 z-40 w-full h-20 bg-canvas border-b border-hairline flex items-center justify-between px-6 md:px-12 py-3">
			<!-- Left Side: Logo & Breadcrumbs -->
			<div class="flex items-center gap-3">
				<!-- Brand Logo -->
				<a href="/" class="flex items-center focus-visible:outline-2 focus-visible:outline-primary py-1" aria-label="Pie Chart Maker Home">
					<!-- Pure Vercel solid black Triangle Logo -->
					<svg width="24" height="21" viewBox="0 0 75 65" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-ink" aria-hidden="true">
						<path d="M37.5 0L75 65H0L37.5 0Z" fill="currentColor"/>
					</svg>
				</a>

				<!-- Breadcrumb divider -->
				<span class="text-hairline-strong font-sans text-sm select-none">/</span>

				<!-- Workspace Selector Dropdown Mockup -->
				<div class="flex items-center">
					<div class="flex items-center gap-2 px-2.5 py-1.5 hover:bg-canvas-soft-2 rounded-md border border-transparent hover:border-hairline transition-all select-none text-ink font-sans text-[13px] font-medium cursor-pointer">
						<!-- Workspace Avatar Mockup (gray circle with initials) -->
						<span class="w-5 h-5 rounded-full bg-primary text-on-primary flex items-center justify-center text-[10px] font-semibold shrink-0">W</span>
						<span>Workspace</span>
						<!-- Chevron -->
						<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-mute" aria-hidden="true">
							<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
				</div>

				<!-- Breadcrumb divider -->
				<span class="text-hairline-strong font-sans text-sm select-none">/</span>

				<!-- Project Selector Dropdown Mockup -->
				<div class="flex items-center">
					<div class="flex items-center gap-2 px-2.5 py-1.5 bg-canvas-soft-2 hover:bg-canvas-soft-2/80 rounded-md border border-hairline shadow-lvl1 transition-colors select-none text-ink font-sans text-[13px] font-medium cursor-pointer">
						<!-- Color Dot Avatar (representing the project) -->
						<span class="w-3.5 h-3.5 rounded-full bg-gradient-to-r from-gradient-develop-start to-gradient-preview-end shadow-lvl1 shrink-0"></span>
						<span>piechartmakerfree.com</span>
						<!-- Chevron -->
						<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-mute" aria-hidden="true">
							<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
				</div>
			</div>
			
			<!-- Right Side: Links & CTAs -->
			<div class="flex items-center gap-4">
				<!-- How It Works Link -->
				<a href="#how-to-use" class="text-body hover:text-ink text-xs font-sans font-medium px-2.5 py-1.5 rounded-md hover:bg-canvas-soft-2 transition-all focus-visible:outline-2 focus-visible:outline-primary">
					How it works
				</a>
			</div>
		</header>

		<!-- Main content -->
		<main id="main-content" class="flex-grow">
			<slot />
		</main>

		<!-- Vercel Footer -->
		<footer class="w-full bg-canvas border-t border-hairline px-6 py-12 md:px-12 md:py-16">
			<div class="max-w-[1200px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
				<div class="flex flex-col gap-3">
					<h3 class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider">Features</h3>
					<ul class="flex flex-col gap-2 font-sans text-sm text-body">
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">2D/3D Extrusion</a></li>
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">Donut / Hole Scaling</a></li>
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">CSV & XLSX Import</a></li>
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">URL Hash Sharing</a></li>
					</ul>
				</div>
				<div class="flex flex-col gap-3">
					<h3 class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider">Other Tools</h3>
					<ul class="flex flex-col gap-2 font-sans text-sm text-body">
						<li><a href="https://realonlineruler.com" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">Online Ruler</a></li>
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">Unit Converter</a></li>
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">Protractor Online</a></li>
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">Screen Caliper</a></li>
					</ul>
				</div>
				<div class="flex flex-col gap-3">
					<h3 class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider">Resources</h3>
					<ul class="flex flex-col gap-2 font-sans text-sm text-body">
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">SVG Specifications</a></li>
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">CSV File Template</a></li>
						<li><a href="#" class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary">Chart Mathematics</a></li>
					</ul>
				</div>
				<div class="flex flex-col gap-3">
					<h3 class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider">About</h3>
					<p class="font-sans text-xs text-mute leading-relaxed">
						Pie Chart Maker is a high-performance developer-inspired tool provided by <a href="https://piechartmakerfree.com" class="text-body hover:text-ink underline">piechartmakerfree.com</a>. Crafted for instant edits and private sharing.
					</p>
				</div>
			</div>
			
			<div class="max-w-[1200px] mx-auto border-t border-hairline pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
				<div class="flex items-center gap-3">
					<svg width="22" height="19" viewBox="0 0 76 65" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-ink" aria-hidden="true">
						<path d="M37.5 0L75.0215 64.5H0L37.5 0Z" fill="currentColor"/>
					</svg>
					<span class="font-sans text-xs text-mute">© {new Date().getFullYear()}&nbsp;piechartmakerfree.com. All rights reserved.</span>
				</div>
				<div class="flex items-center gap-6 font-sans text-xs text-mute">
					<a href="#" class="hover:text-ink transition-colors">Privacy Policy</a>
					<a href="#" class="hover:text-ink transition-colors">Terms of Service</a>
				</div>
			</div>
		</footer>
	</body>
</html>
