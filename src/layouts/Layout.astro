---
import "../styles/global.css";
import {
	getLangFromUrl,
	useTranslations,
	useTranslatedPath,
	getHreflangList,
	getCanonicalUrl,
} from "../i18n/utils";
import { ogLocales, type SupportedLanguage } from "../i18n/ui";
import LanguagePicker from "../components/LanguagePicker.astro";

interface Props {
	title?: string;
	description?: string;
	robots?: string;
	keywords?: string;
	lang?: SupportedLanguage;
}

const urlLang = getLangFromUrl(Astro.url);
const currentLang = Astro.props.lang || urlLang;
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const title = Astro.props.title || t("meta.title");
const description = Astro.props.description || t("meta.description");
const keywords = Astro.props.keywords || t("meta.keywords");
const robots = Astro.props.robots;

const hreflangs = getHreflangList(Astro.url);
const canonicalUrl = getCanonicalUrl(Astro.url);
const ogLocale = ogLocales[currentLang] || "en_US";
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link
			rel="icon"
			type="image/png"
			href="/favicon-96x96.png"
			sizes="96x96"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<meta name="apple-mobile-web-app-title" content="Pie Chart" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap.xml" />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl} />

		<!-- Hreflang Tags for Multi-Language SEO -->
		{
			hreflangs.map((entry) => (
				<link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
			))
		}

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		<meta name="keywords" content={keywords} />
		<meta name="author" content="piechartmakerfree.com" />

		<!-- Theme Color -->
		<meta name="theme-color" id="theme-color" content="#fafafa" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://piechartmakerfree.com/web-app-manifest-512x512.png" />
		<meta property="og:site_name" content={t("nav.logo")} />
		<meta property="og:locale" content={ogLocale} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="https://piechartmakerfree.com/web-app-manifest-512x512.png" />

		<!-- Prevent flash of wrong theme -->
		<script>
			(function () {
				const key = "pie_chart_theme";
				var stored = (function () {
					try {
						return localStorage.getItem(key);
					} catch (e) {
						return null;
					}
				})();
				var theme;
				if (stored === "dark" || stored === "light") {
					theme = stored;
				} else {
					theme = window.matchMedia("(prefers-color-scheme: dark)")
						.matches
						? "dark"
						: "light";
				}
				if (theme === "dark") {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1G4KVZC22"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-P1G4KVZC22');
		</script>
	</head>
	<body class="flex flex-col min-h-screen bg-canvas-soft text-ink">
		<!-- Skip Link for Accessibility -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:rounded-sm focus:outline-none"
		>
			{t("nav.skip")}
		</a>

		<!-- Vercel Nav Bar -->
		<header
			class="sticky top-0 z-50 w-full h-14 bg-canvas/95 backdrop-blur-md border-b border-hairline flex items-center justify-between px-4 md:px-12 transition-colors"
		>
			<!-- Left Side: Logo & Website Name -->
			<div class="flex items-center gap-2 md:gap-3">
				<!-- Brand Logo & Name -->
				<a
					href={translatePath("/")}
					class="flex items-center gap-1.5 md:gap-2.5 focus-visible:outline-2 focus-visible:outline-primary py-1"
					aria-label={`${t("nav.logo")} Home`}
				>
					<!-- Pure Vercel solid black Triangle Logo -->
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="w-6 h-6 rotate-45 text-ink shrink-0"
						aria-hidden="true"
					>
						<path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
						<path d="M22 12A10 10 0 0 0 12 2v10z"></path>
					</svg>
					<span
						class="font-sans text-[13px] sm:text-[14px] md:text-[15px] font-semibold tracking-tight text-ink"
						>{t("nav.logo")}</span
					>
				</a>
			</div>

			<!-- Right Side: Links & CTAs -->
			<div class="flex items-center gap-1.5 md:gap-2.5">
				<!-- Language Switcher in Nav -->
				<LanguagePicker variant="nav" />

				<!-- Dark Mode Toggle -->
				<button
					id="theme-toggle"
					type="button"
					class="w-8 h-8 inline-flex items-center justify-center rounded-md text-body hover:text-ink hover:bg-canvas-soft-2 transition-all focus-visible:outline-2 focus-visible:outline-primary cursor-pointer"
					aria-label={t("nav.toggleTheme")}
					title={t("nav.toggleTheme")}
				>
					<!-- Sun icon (shown in dark mode) -->
					<svg
						id="icon-sun"
						class="hidden w-4 h-4"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
						></path>
					</svg>
					<!-- Moon icon (shown in light mode) -->
					<svg
						id="icon-moon"
						class="block w-4 h-4"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
						></path>
					</svg>
				</button>

				<!-- How It Works Link -->
				<a
					href={translatePath("/#how-to-use")}
					class="text-body hover:text-ink text-[11px] sm:text-xs font-sans font-medium px-2.5 py-1.5 rounded-md hover:bg-canvas-soft-2 transition-all focus-visible:outline-2 focus-visible:outline-primary"
				>
					{t("nav.howItWorks")}
				</a>
			</div>
		</header>

		<!-- Main content -->
		<main id="main-content" class="flex-grow">
			<slot />
		</main>

		<!-- Vercel Footer -->
		<footer
			class="w-full bg-canvas border-t border-hairline px-6 py-12 md:px-12 md:py-16"
		>
			<div
				class="max-w-[1200px] mx-auto grid grid-cols-2 md:grid-cols-3 gap-8 mb-8"
			>
				<div class="flex flex-col gap-3">
					<h3
						class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider"
					>
						{t("footer.features")}
					</h3>
					<ul class="flex flex-col gap-2 font-sans text-sm text-body">
						<li>
							<a
								href={translatePath("/#editor-workspace")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.feat1")}</a>
						</li>
						<li>
							<a
								href={translatePath("/#editor-workspace")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.feat2")}</a>
						</li>
						<li>
							<a
								href={translatePath("/#editor-workspace")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.feat3")}</a>
						</li>
						<li>
							<a
								href={translatePath("/#editor-workspace")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.feat4")}</a>
						</li>
					</ul>
				</div>
				<!-- Other Tools section hidden for now -->
				<div class="flex flex-col gap-3">
					<h3
						class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider"
					>
						{t("footer.resources")}
					</h3>
					<ul class="flex flex-col gap-2 font-sans text-sm text-body">
						<li>
							<a
								href={translatePath("/#how-to-use")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.res1")}</a>
						</li>
						<li>
							<a
								href={translatePath("/#how-to-use")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.res2")}</a>
						</li>
						<li>
							<a
								href={translatePath("/#how-to-use")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.res3")}</a>
						</li>
					</ul>
				</div>
				<div class="flex flex-col gap-3">
					<h3
						class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider"
					>
						{t("footer.company")}
					</h3>
					<ul class="flex flex-col gap-2 font-sans text-sm text-body">
						<li>
							<a
								href={translatePath("/about")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.comp1")}</a
							>
						</li>
						<li>
							<a
								href={translatePath("/contact")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.comp2")}</a
							>
						</li>
						<li>
							<a
								href={translatePath("/privacy")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.comp3")}</a
							>
						</li>
						<li>
							<a
								href={translatePath("/terms")}
								class="hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-primary"
								>{t("footer.comp4")}</a
							>
						</li>
					</ul>
				</div>
			</div>

			<!-- Footer Language Selector -->
			<div class="max-w-[1200px] mx-auto py-4 border-t border-hairline/60">
				<LanguagePicker variant="footer" />
			</div>

			<div
				class="max-w-[1200px] mx-auto border-t border-hairline pt-6 flex flex-col md:flex-row items-center justify-between gap-4"
			>
				<div class="flex items-center gap-3">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="w-5 h-5 rotate-45 text-ink shrink-0"
						aria-hidden="true"
					>
						<path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
						<path d="M22 12A10 10 0 0 0 12 2v10z"></path>
					</svg>
					<span class="font-sans text-xs text-mute"
						>© {
							new Date().getFullYear()
						}&nbsp;piechartmakerfree.com. {t("footer.copyright")}</span
					>
				</div>
				<div
					class="flex items-center gap-6 font-sans text-xs text-mute"
				>
					<a href={translatePath("/privacy")} class="hover:text-ink transition-colors"
						>{t("footer.comp3")}</a
					>
					<a href={translatePath("/terms")} class="hover:text-ink transition-colors"
						>{t("footer.comp4")}</a
					>
				</div>
			</div>
		</footer>
		<!-- Dark Mode Script -->
		<script>
			const storageKey = "pie_chart_theme";
			const htmlEl = document.documentElement;
			const toggleBtn = document.getElementById("theme-toggle");
			const iconSun = document.getElementById("icon-sun");
			const iconMoon = document.getElementById("icon-moon");
			const themeColorMeta = document.getElementById("theme-color");

			function getPreferredTheme() {
				const stored = localStorage.getItem(storageKey);
				if (stored === "dark" || stored === "light") return stored;
				return window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light";
			}

			function applyTheme(theme) {
				const isDark = theme === "dark";
				htmlEl.classList.toggle("dark", isDark);
				if (iconSun) iconSun.classList.toggle("hidden", !isDark);
				if (iconMoon) iconMoon.classList.toggle("hidden", isDark);
				if (themeColorMeta) {
					themeColorMeta.content = isDark ? "#111111" : "#fafafa";
				}
			}

			function setTheme(theme) {
				applyTheme(theme);
				try {
					localStorage.setItem(storageKey, theme);
				} catch (e) {}
			}

			function toggleTheme() {
				const current = htmlEl.classList.contains("dark")
					? "dark"
					: "light";
				setTheme(current === "dark" ? "light" : "dark");
			}

			// Apply initial theme
			applyTheme(getPreferredTheme());

			// Listen for toggle
			if (toggleBtn) {
				toggleBtn.addEventListener("click", toggleTheme);
			}

			// Listen for system preference changes (only if no stored preference)
			window
				.matchMedia("(prefers-color-scheme: dark)")
				.addEventListener("change", (e) => {
					if (!localStorage.getItem(storageKey)) {
						applyTheme(e.matches ? "dark" : "light");
					}
				});
		</script>
	</body>
</html>
