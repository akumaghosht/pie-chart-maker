---
import Layout from '../../layouts/Layout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';

export async function getStaticPaths() {
  const staticLangs = ['it', 'fr', 'de'];
  return (Object.keys(languages) as SupportedLanguage[])
    .filter((l) => l !== defaultLang && !staticLangs.includes(l))
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<Layout lang={lang}>
  <HomeContent lang={lang} />
</Layout>
