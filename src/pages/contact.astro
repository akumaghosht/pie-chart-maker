---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — Pie Chart Maker" description="Get in touch with us for support, feature requests, or business inquiries about Pie Chart Maker.">
  <main class="w-full">
    <!-- Hero Header -->
    <section class="relative w-full mesh-gradient-bg border-b border-hairline py-16 md:py-24 overflow-hidden">
      <div class="absolute -top-[20%] left-[30%] w-[50%] h-[350px] bg-radial from-color-link/5 via-color-violet/5 to-transparent blur-3xl pointer-events-none"></div>
      
      <div class="max-w-[800px] mx-auto px-6 text-center md:text-left relative z-10">
        <span class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider select-none">Get In Touch</span>
        <h1 class="font-sans text-[32px] sm:text-[36px] md:text-[56px] font-semibold tracking-[-1px] sm:tracking-[-2px] text-ink leading-tight md:leading-[1.05] mt-2 mb-6">
          Contact us.
        </h1>
        <p class="font-sans text-[16px] md:text-[18px] text-body leading-relaxed max-w-[640px]">
          Have questions, feature requests, or feedback? Send us a message and we'll get back to you as soon as possible.
        </p>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="w-full bg-canvas py-16 md:py-24">
      <div class="max-w-[600px] mx-auto px-6">
        <!-- Success Message (hidden initially) -->
        <div id="success-panel" class="hidden flex flex-col items-center text-center p-8 bg-canvas-soft border border-success rounded-md shadow-lvl2 animate-fade-in">
          <div class="w-12 h-12 rounded-full bg-success/10 text-success flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <h2 class="font-sans text-xl font-semibold text-ink mb-2">Message Sent!</h2>
          <p class="font-sans text-sm text-body leading-relaxed max-w-[400px]">
            Thank you for reaching out. We have received your message and will respond shortly.
          </p>
          <button id="reset-btn" type="button" class="mt-6 inline-flex items-center justify-center h-9 px-4 bg-primary text-on-primary text-xs font-sans font-medium rounded-md hover:bg-primary/90 transition-colors cursor-pointer">
            Send another message
          </button>
        </div>

        <!-- Contact Form -->
        <form id="contact-form" class="flex flex-col gap-6">
          <div class="flex flex-col gap-1.5">
            <label for="name" class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider">Your Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="Alex Morgan" 
              class="w-full h-10 px-3.5 bg-canvas border border-hairline rounded-md font-sans text-sm text-ink placeholder-mute focus:outline-none focus:border-hairline-strong focus-visible:outline-2 focus-visible:outline-primary transition-all"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider">Email Address</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="alex@example.com" 
              class="w-full h-10 px-3.5 bg-canvas border border-hairline rounded-md font-sans text-sm text-ink placeholder-mute focus:outline-none focus:border-hairline-strong focus-visible:outline-2 focus-visible:outline-primary transition-all"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider">Message</label>
            <textarea 
              id="message" 
              name="message" 
              rows="6" 
              required 
              placeholder="How can we help you?" 
              class="w-full p-3.5 bg-canvas border border-hairline rounded-md font-sans text-sm text-ink placeholder-mute focus:outline-none focus:border-hairline-strong focus-visible:outline-2 focus-visible:outline-primary transition-all resize-y"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="inline-flex items-center justify-center h-10 px-5 bg-primary text-on-primary text-xs font-sans font-medium rounded-md hover:bg-primary/90 transition-colors shadow-lvl2 focus-visible:outline-2 focus-visible:outline-primary cursor-pointer w-full sm:w-auto self-start"
          >
            Submit Message
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successPanel = document.getElementById('success-panel');
  const resetBtn = document.getElementById('reset-btn');

  if (form && successPanel) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Basic validation check
      if (form.checkValidity()) {
        // Here you would typically send data to a backend endpoint.
        // Since this app is client-side, we simulate form submission success.
        form.classList.add('hidden');
        successPanel.classList.remove('hidden');
        form.reset();
      }
    });
  }

  if (resetBtn && form && successPanel) {
    resetBtn.addEventListener('click', () => {
      successPanel.classList.add('hidden');
      form.classList.remove('hidden');
    });
  }
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
