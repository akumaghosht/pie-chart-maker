---
import Layout from "../../layouts/Layout.astro";
import SEOHead from "../../components/SEOHead.astro";
import ChartMaker from "../../components/ChartMaker.astro";
import itData from "../../content/i18n/it.json";

const lang = "it";
const canonicalUrl = "https://piechartmakerfree.com/it/";
const secondaryKeywordsStr = itData.secondaryKeywords.join(", ");
---

<Layout
  title={itData.title}
  description={itData.metaDescription}
  canonicalUrl={canonicalUrl}
  keywords={secondaryKeywordsStr}
  lang={lang}
  includeHreflang={true}
>
  <SEOHead
    slot="head"
    title={itData.title}
    metaDescription={itData.metaDescription}
    canonicalUrl={canonicalUrl}
    keywords={secondaryKeywordsStr}
    lang={lang}
    includeHreflang={true}
    faqs={itData.faqs}
  />

  <!-- Hero Section -->
  <section class="relative w-full mesh-gradient-bg border-b border-hairline py-14 md:py-20 overflow-hidden">
    <div class="absolute -top-[25%] left-[25%] w-[55%] h-[320px] bg-radial from-color-link/5 via-color-violet/5 to-transparent blur-3xl pointer-events-none"></div>
    <div class="max-w-[1200px] mx-auto px-6 text-center flex flex-col items-center gap-4 relative z-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-pill text-[11px] font-mono font-medium bg-canvas border border-hairline text-ink shadow-lvl1 uppercase tracking-wider">
        Creatore di Grafici a Torta Online Gratis
      </span>
      <h1 class="font-sans text-[30px] sm:text-[38px] md:text-[52px] font-semibold tracking-[-1.5px] sm:tracking-[-2px] text-ink leading-tight md:leading-[1.08] max-w-[850px] text-balance">
        {itData.h1}
      </h1>
      <p class="font-sans text-[15px] md:text-[18px] text-body leading-relaxed max-w-[680px] text-balance">
        {itData.heroSubtitle}
      </p>
    </div>
  </section>

  <!-- Interactive Editor Workspace -->
  <section id="editor-workspace" class="w-full bg-canvas-soft border-b border-hairline py-4">
    <ChartMaker
      lang={lang}
      translations={itData.ui}
      initialTitle="Distribuzione Risorse"
      initialSubtitle="Ripartizione Spese Annuali"
    />
  </section>

  <!-- Localized FAQs Section -->
  <section class="w-full bg-canvas-soft-2 border-b border-hairline py-16 md:py-24" id="faq">
    <div class="max-w-[800px] mx-auto px-6">
      <div class="text-center md:text-left mb-12">
        <span class="font-mono text-[11px] font-semibold text-hairline-strong uppercase tracking-wider select-none">
          Domande Frequenti
        </span>
        <h2 class="font-sans text-[26px] md:text-[34px] font-semibold tracking-[-1px] text-ink mt-2 text-balance">
          Come Creare, Formattare ed Esportare il Grafico a Torta
        </h2>
        <p class="font-sans text-sm text-body leading-relaxed mt-2 max-w-[560px]">
          Tutto quello che devi sapere per creare diagrammi a torta e grafici a ciambella online gratis in pochi secondi.
        </p>
      </div>

      <div class="flex flex-col gap-4">
        {
          itData.faqs.map((item) => (
            <details class="group bg-canvas border border-hairline rounded-md overflow-hidden transition-all duration-200 open:shadow-lvl2">
              <summary class="flex justify-between items-center p-5 font-sans font-medium text-ink hover:text-primary cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-primary select-none [&::-webkit-details-marker]:hidden">
                <span class="text-sm md:text-base font-semibold">{item.question}</span>
                <span class="text-mute group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4">
                  <svg class="w-5 h-5 stroke-current" fill="none" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5 pt-0 border-t border-hairline/50 font-sans text-xs md:text-sm text-body leading-relaxed">
                <p>{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

